    #[test]
    fn temporal_analysis_resolves_current_history_and_transitions() -> Result<()> {
        let db = SqliteMemoryDb::open(":memory:")?;

        db.initialize_schema()?;
        db.initialize_vector_index(4)?;

        seed_temporal_chunk(
            &db,
            "note-state-a",
            "chunk-state-a",
            "states/a.md",
            "Qwen3.5 used Model A.",
            None,
            None,
        )?;
        seed_temporal_chunk(
            &db,
            "note-state-overlap",
            "chunk-state-overlap",
            "states/overlap.md",
            "Qwen3.5 also used Model C.",
            None,
            None,
        )?;
        seed_temporal_chunk(
            &db,
            "note-state-b",
            "chunk-state-b",
            "states/b.md",
            "Qwen3.5 uses Model B.",
            None,
            None,
        )?;

        let entity_id = SqliteMemoryDb::entity_id("Qwen3.5");

        db.conn.execute(
            "INSERT INTO entities (id, name, entity_type)\n             VALUES (?1, 'Qwen3.5', 'model')",
            params![entity_id],
        )?;

        db.conn.execute(
            "INSERT INTO entity_aliases (identity_key, entity_id)\n             VALUES ('qwen3.5', ?1)",
            params![entity_id],
        )?;

        db.conn.execute(
            "INSERT INTO states (id, note_id, ordinal, entity_id, state, valid_from, valid_to)\n             VALUES (?1, 'note-state-a', 0, ?2, 'Model A', '2026-01-01', '2026-06-30')",
            params![SqliteMemoryDb::state_id("note-state-a", 0), entity_id],
        )?;

        db.conn.execute(
            "INSERT INTO states (id, note_id, ordinal, entity_id, state, valid_from, valid_to)\n             VALUES (?1, 'note-state-overlap', 0, ?2, 'Model C', '2026-06-15', '2026-07-15')",
            params![
                SqliteMemoryDb::state_id("note-state-overlap", 0),
                entity_id
            ],
        )?;

        db.conn.execute(
            "INSERT INTO states (id, note_id, ordinal, entity_id, state, valid_from, valid_to)\n             VALUES (?1, 'note-state-b', 0, ?2, 'Model B', '2026-07-16', NULL)",
            params![SqliteMemoryDb::state_id("note-state-b", 0), entity_id],
        )?;

        let current = db.temporal_analysis_for_entity("Qwen 3.5", Some("2026-08-01"))?;

        assert_eq!(current.entity, "Qwen3.5");
        assert_eq!(current.as_of, "2026-08-01");
        assert!(!current.ambiguous);
        assert_eq!(
            current
                .active_state
                .as_ref()
                .map(|state| state.state.as_str()),
            Some("Model B")
        );
        assert_eq!(current.states.len(), 3);
        assert_eq!(current.transitions.len(), 2);
        assert_eq!(
            current.transitions[0].kind,
            TemporalTransitionKind::Overlaps
        );
        assert_eq!(
            current.transitions[1].kind,
            TemporalTransitionKind::SupersededBy
        );

        let overlap = db.temporal_analysis_for_entity("QWEN3.5", Some("2026-06-20"))?;

        assert!(overlap.ambiguous);
        assert!(overlap.active_state.is_none());
        assert!(
            overlap
                .states
                .iter()
                .filter(|observation| observation.status == TemporalStateStatus::Current)
                .count()
                == 2
        );

        Ok(())
    }

    #[test]
    fn current_temporal_marker_uses_today_and_removes_marker_from_search() {
        let (search_query, temporal_date) =
            SqliteMemoryDb::temporal_search_query("current Qwen3.5 model");

        assert_eq!(search_query, "Qwen3.5 model");
        assert_eq!(
            temporal_date,
            Some(OffsetDateTime::now_utc().date().to_string())
        );
    }
}

#[cfg(test)]
mod conversation_tests {
    #[test]
    fn legacy_conversation_schema_is_migrated() -> Result<()> {
        let directory = tempfile::tempdir()?;

        let database = directory.path().join("legacy.db");

        {
            let connection = rusqlite::Connection::open(&database)?;

            connection.execute_batch(
                r#"
                CREATE TABLE conversation_turns (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    created_at TEXT NOT NULL,
                    user_text TEXT NOT NULL,
                    assistant_text TEXT NOT NULL
                );
                "#,
            )?;

            connection.execute(
                r#"
                INSERT INTO conversation_turns (
                    created_at,
                    user_text,
                    assistant_text
                )
                VALUES (
                    '2026-01-01T00:00:00Z',
                    'Legacy question',
                    'Legacy response'
                )
                "#,
                [],
            )?;
        }

        let db = SqliteMemoryDb::open(&database)?;

        db.initialize_schema()?;

        db.append_conversation_turn("new-session", "New question", "New response")?;

        let legacy = db.recent_conversation_turns("legacy", 8)?;

        let current = db.recent_conversation_turns("new-session", 8)?;

        assert_eq!(
            legacy,
            vec![("Legacy question".to_string(), "Legacy response".to_string(),),]
        );

        assert_eq!(
            current,
            vec![("New question".to_string(), "New response".to_string(),),]
        );

        Ok(())
    }

    use super::*;

    fn test_db() -> Result<(tempfile::TempDir, SqliteMemoryDb)> {
        let directory = tempfile::tempdir()?;

        let database = directory.path().join("test.db");

        let db = SqliteMemoryDb::open(&database)?;

        db.initialize_schema()?;

        Ok((directory, db))
    }

    #[test]
    fn conversation_history_round_trip() -> Result<()> {
        let (_directory, db) = test_db()?;

        db.append_conversation_turn("test-session", "Hello", "Hi there.")?;

        db.append_conversation_turn("test-session", "What is Qwen?", "A local model.")?;

        let turns = db.recent_conversation_turns("test-session", 8)?;

        assert_eq!(
            turns,
            vec![
                ("Hello".to_string(), "Hi there.".to_string()),
                ("What is Qwen?".to_string(), "A local model.".to_string()),
            ]
        );

        Ok(())
    }

    #[test]
    fn conversation_turn_can_be_loaded_by_id() -> Result<()> {
        let (_directory, db) = test_db()?;
        let id = db.append_conversation_turn("test-session", "Hello", "Hi")?;
        let turn = db
            .conversation_turn(id)?
            .ok_or("conversation turn missing")?;
        assert_eq!(turn.id, id);
        assert_eq!(turn.session_id, "test-session");
        assert_eq!(turn.user_text, "Hello");
        assert_eq!(turn.assistant_text, "Hi");
        Ok(())
    }

    #[test]
    fn memory_extraction_proposal_round_trip() -> Result<()> {
        let (_directory, db) = test_db()?;
        let turn_id = db.append_conversation_turn("test-session", "Remember Qwen.", "Okay.")?;
        let proposal_id = db.store_memory_extraction_proposal(
            turn_id,
            "must_save",
            r#"{"decision":"must_save","items":[]}"#,
        )?;
        let proposal = db
            .memory_extraction_proposal(&proposal_id)?
            .ok_or("proposal missing")?;
        assert_eq!(proposal.conversation_turn_id, turn_id);
        assert_eq!(proposal.decision, "must_save");
        assert_eq!(proposal.status, "pending");
        Ok(())
    }

    #[test]
    fn memory_extraction_proposal_rejects_missing_turn() -> Result<()> {
        let (_directory, db) = test_db()?;
        assert!(
            db.store_memory_extraction_proposal(999, "uncertain", r#"{}"#)
                .is_err()
        );
        Ok(())
    }

    #[test]
    fn memory_extraction_proposal_status_transitions_are_idempotent() -> Result<()> {
        let (_directory, db) = test_db()?;
        let turn_id = db.append_conversation_turn("session", "Save this", "Okay")?;
        let id = db.store_memory_extraction_proposal(
            turn_id,
            "should_save",
            r#"{"decision":"should_save","items":[{"kind":"fact","title":"Fact","body":"Body","tags":[],"entities":[],"relationships":[],"events":[],"states":[]}] }"#,
        )?;

        assert!(db.set_memory_extraction_proposal_status(&id, "pending", "applying")?);
        assert!(!db.set_memory_extraction_proposal_status(&id, "pending", "applying")?);
        assert!(db.reject_memory_extraction_proposal(&id).is_err());
        assert!(db.set_memory_extraction_proposal_status(&id, "applying", "pending")?);
        assert!(db.set_memory_extraction_proposal_status(&id, "pending", "applying")?);
        assert!(db.set_memory_extraction_proposal_status(&id, "applying", "applied")?);
        assert!(
            db.set_memory_extraction_proposal_status(&id, "applied", "rejected")
                .is_err()
        );
        Ok(())
    }

    #[test]
    fn pending_memory_extraction_proposals_are_listed_oldest_first() -> Result<()> {
        let (_directory, db) = test_db()?;
        let turn_id = db.append_conversation_turn("session", "Save this", "Okay")?;
        let first = db.store_memory_extraction_proposal(
            turn_id,
            "should_save",
            r#"{"decision":"should_save","items":[{"kind":"fact","title":"One","body":"Body","tags":[],"entities":[],"relationships":[],"events":[],"states":[]}] }"#,
        )?;
        let second = db.store_memory_extraction_proposal(
            turn_id,
            "should_save",
            r#"{"decision":"should_save","items":[{"kind":"fact","title":"Two","body":"Body","tags":[],"entities":[],"relationships":[],"events":[],"states":[]}] }"#,
        )?;

        let proposals = db.pending_memory_extraction_proposals(10)?;
        assert_eq!(proposals.len(), 2);
        assert_eq!(proposals[0].id, first);
        assert_eq!(proposals[1].id, second);
        Ok(())
    }

    #[test]
    fn supersession_valid_to_is_previous_day() -> Result<()> {
        assert_eq!(
            SqliteMemoryDb::supersession_valid_to("2026-09-12")?,
            "2026-09-11"
        );
        assert_eq!(
            SqliteMemoryDb::supersession_valid_to("2026-01-01")?,
            "2025-12-31"
        );
        assert!(SqliteMemoryDb::supersession_valid_to("not-a-date").is_err());
        Ok(())
    }

    #[test]
    fn memory_evolution_detects_exact_duplicate() -> Result<()> {
        let (_directory, mut db) = test_db()?;
        use indexer::model::{IndexStats, NoteRecord};

        let snapshot = IndexSnapshot {
            notes: vec![NoteRecord {
                id: "note-duplicate".to_string(),
                path: "journal/extracted/existing.md".to_string(),
                title: "Preference".to_string(),
                note_type: "journal".to_string(),
                namespace: "journal".to_string(),
                canonical: false,
                status: "active".to_string(),
                memory_kind: None,
                task_status: None,
                reminder_status: None,
                checksum: "checksum".to_string(),
                captured_at: None,
                occurred_at: None,
                valid_from: None,
                valid_to: None,
                due_at: None,
                updated_at: None,
                created_at: None,
                body: "# Preference\n\nPrefers Qwen.".to_string(),
                entities: Vec::new(),
                relationships: Vec::new(),
                events: Vec::new(),
                states: Vec::new(),
            }],
            chunks: Vec::new(),
            stats: IndexStats::default(),
        };

        db.sync_snapshot(&snapshot)?;
        let assessment = db.assess_memory_evolution("Preference", "Prefers Qwen.", &[])?;

        assert_eq!(
            assessment.disposition,
            MemoryEvolutionDisposition::Duplicate
        );
        assert_eq!(assessment.matches[0].path, "journal/extracted/existing.md");
        Ok(())
    }

    #[test]
    fn memory_evolution_allows_multiple_notes_with_same_fingerprint() -> Result<()> {
        let (_directory, mut db) = test_db()?;
        use indexer::model::{IndexStats, NoteRecord};

        let make_note = |id: &str, path: &str| NoteRecord {
            id: id.to_string(),
            path: path.to_string(),
            title: "Same memory".to_string(),
            note_type: "journal".to_string(),
            namespace: "journal".to_string(),
            canonical: false,
            status: "active".to_string(),
            memory_kind: None,
            task_status: None,
            reminder_status: None,
            checksum: format!("checksum-{id}"),
            captured_at: None,
            occurred_at: None,
            valid_from: None,
            valid_to: None,
            due_at: None,
            updated_at: None,
            created_at: None,
            body: "# Same memory\n\nSame content.".to_string(),
            entities: Vec::new(),
            relationships: Vec::new(),
            events: Vec::new(),
            states: Vec::new(),
        };

        let snapshot = IndexSnapshot {
            notes: vec![
                make_note("note-a", "journal/extracted/a.md"),
                make_note("note-b", "journal/extracted/b.md"),
            ],
            chunks: Vec::new(),
            stats: IndexStats::default(),
        };

        db.sync_snapshot(&snapshot)?;
        let assessment = db.assess_memory_evolution("Same memory", "Same content.", &[])?;

        assert_eq!(
            assessment.disposition,
            MemoryEvolutionDisposition::Duplicate
        );
        assert_eq!(assessment.matches.len(), 1);
        assert_eq!(assessment.matches[0].path, "journal/extracted/a.md");
        Ok(())
    }

    #[test]
    fn memory_evolution_requires_supersession_for_new_open_state() -> Result<()> {
        let (_directory, mut db) = test_db()?;
        use indexer::model::{IndexStats, NoteRecord, StateRecord};

        let snapshot = IndexSnapshot {
            notes: vec![NoteRecord {
                id: "note-state".to_string(),
                path: "journal/extracted/state.md".to_string(),
                title: "Model state".to_string(),
                note_type: "journal".to_string(),
                namespace: "journal".to_string(),
                canonical: false,
                status: "active".to_string(),
                memory_kind: None,
                task_status: None,
                reminder_status: None,
                checksum: "checksum".to_string(),
                captured_at: None,
                occurred_at: None,
                valid_from: None,
                valid_to: None,
                due_at: None,
                updated_at: None,
                created_at: None,
                body: "# Model state\n\nCurrent model.".to_string(),
                entities: vec![EntityRecord {
                    name: "Qwen".to_string(),
                    entity_type: "model".to_string(),
                }],
                relationships: Vec::new(),
                events: Vec::new(),
                states: vec![StateRecord {
                    entity: "Qwen".to_string(),
                    state: "preferred".to_string(),
                    valid_from: Some("2026-01-01".to_string()),
                    valid_to: None,
                }],
            }],
            chunks: Vec::new(),
            stats: IndexStats::default(),
        };

        db.sync_snapshot(&snapshot)?;
        db.sync_semantics(&snapshot)?;

        let assessment = db.assess_memory_evolution(
            "Model state update",
            "Changed model state.",
            &[GraphState {
                entity: "Qwen".to_string(),
                state: "not_preferred".to_string(),
                valid_from: Some("2026-09-12".to_string()),
                valid_to: None,
            }],
        )?;

        assert_eq!(
            assessment.disposition,
            MemoryEvolutionDisposition::SupersessionRequired
        );
        assert_eq!(assessment.matches[0].path, "journal/extracted/state.md");
        Ok(())
    }

    #[test]
    fn memory_evolution_marks_multiple_open_predecessors_as_ambiguous() -> Result<()> {
        let (_directory, mut db) = test_db()?;
        use indexer::model::{IndexStats, NoteRecord, StateRecord};

        let make_note = |id: &str, path: &str, state: &str, valid_from: &str| NoteRecord {
            id: id.to_string(),
            path: path.to_string(),
            title: format!("Project state {id}"),
            note_type: "journal".to_string(),
            namespace: "journal".to_string(),
            canonical: false,
            status: "active".to_string(),
            memory_kind: None,
            task_status: None,
            reminder_status: None,
            checksum: format!("checksum-{id}"),
            captured_at: None,
            occurred_at: None,
            valid_from: None,
            valid_to: None,
            due_at: None,
            updated_at: None,
            created_at: None,
            body: format!("# Project state {id}\n\n{state}."),
            entities: vec![EntityRecord {
                name: "Project".to_string(),
                entity_type: "project".to_string(),
            }],
            relationships: Vec::new(),
            events: Vec::new(),
            states: vec![StateRecord {
                entity: "Project".to_string(),
                state: state.to_string(),
                valid_from: Some(valid_from.to_string()),
                valid_to: None,
            }],
        };

        let snapshot = IndexSnapshot {
            notes: vec![
                make_note(
                    "state-a",
                    "journal/extracted/state-a.md",
                    "active",
                    "2026-01-01",
                ),
                make_note(
                    "state-b",
                    "journal/extracted/state-b.md",
                    "planning",
                    "2026-06-01",
                ),
            ],
            chunks: Vec::new(),
            stats: IndexStats::default(),
        };

        db.sync_snapshot(&snapshot)?;
        db.sync_semantics(&snapshot)?;

        let assessment = db.assess_memory_evolution(
            "Project state update",
            "Project is paused.",
            &[GraphState {
                entity: "Project".to_string(),
                state: "paused".to_string(),
                valid_from: Some("2026-09-12".to_string()),
                valid_to: None,
            }],
        )?;

        assert_eq!(
            assessment.disposition,
            MemoryEvolutionDisposition::Ambiguous
        );
        assert_eq!(assessment.matches.len(), 2);
        assert_eq!(assessment.matches[0].path, "journal/extracted/state-a.md");
        assert_eq!(assessment.matches[1].path, "journal/extracted/state-b.md");
        Ok(())
    }

    #[test]
    fn memory_evolution_detects_overlapping_conflict() -> Result<()> {
        let (_directory, mut db) = test_db()?;
        use indexer::model::{IndexStats, NoteRecord, StateRecord};

        let snapshot = IndexSnapshot {
            notes: vec![NoteRecord {
                id: "note-conflict".to_string(),
                path: "journal/extracted/conflict.md".to_string(),
                title: "State".to_string(),
                note_type: "journal".to_string(),
                namespace: "journal".to_string(),
                canonical: false,
                status: "active".to_string(),
                memory_kind: None,
                task_status: None,
                reminder_status: None,
                checksum: "checksum".to_string(),
                captured_at: None,
                occurred_at: None,
                valid_from: None,
                valid_to: None,
                due_at: None,
                updated_at: None,
                created_at: None,
                body: "# State\n\nOverlapping state.".to_string(),
                entities: vec![EntityRecord {
                    name: "Project".to_string(),
                    entity_type: "project".to_string(),
                }],
                relationships: Vec::new(),
                events: Vec::new(),
                states: vec![StateRecord {
                    entity: "Project".to_string(),
                    state: "active".to_string(),
                    valid_from: Some("2026-09-01".to_string()),
                    valid_to: Some("2026-09-30".to_string()),
                }],
            }],
            chunks: Vec::new(),
            stats: IndexStats::default(),
        };

        db.sync_snapshot(&snapshot)?;
        db.sync_semantics(&snapshot)?;

        let assessment = db.assess_memory_evolution(
            "State change",
            "Conflict.",
            &[GraphState {
                entity: "Project".to_string(),
                state: "paused".to_string(),
                valid_from: Some("2026-09-15".to_string()),
                valid_to: Some("2026-09-20".to_string()),
            }],
        )?;

        assert_eq!(assessment.disposition, MemoryEvolutionDisposition::Conflict);
        assert_eq!(assessment.matches[0].path, "journal/extracted/conflict.md");
        Ok(())
    }

    #[test]
    fn memory_evolution_allows_non_overlapping_successor_state() -> Result<()> {
        let (_directory, mut db) = test_db()?;
        use indexer::model::{IndexStats, NoteRecord, StateRecord};

        let snapshot = IndexSnapshot {
            notes: vec![NoteRecord {
                id: "note-history".to_string(),
                path: "journal/extracted/history.md".to_string(),
                title: "State history".to_string(),
                note_type: "journal".to_string(),
                namespace: "journal".to_string(),
                canonical: false,
                status: "active".to_string(),
                memory_kind: None,
                task_status: None,
                reminder_status: None,
                checksum: "checksum".to_string(),
                captured_at: None,
                occurred_at: None,
                valid_from: None,
                valid_to: None,
                due_at: None,
                updated_at: None,
                created_at: None,
                body: "# State history\n\nPrevious state.".to_string(),
                entities: vec![EntityRecord {
                    name: "Project".to_string(),
                    entity_type: "project".to_string(),
                }],
                relationships: Vec::new(),
                events: Vec::new(),
                states: vec![StateRecord {
                    entity: "Project".to_string(),
                    state: "active".to_string(),
                    valid_from: Some("2026-01-01".to_string()),
                    valid_to: Some("2026-06-30".to_string()),
                }],
            }],
            chunks: Vec::new(),
            stats: IndexStats::default(),
        };

        db.sync_snapshot(&snapshot)?;
        db.sync_semantics(&snapshot)?;

        let assessment = db.assess_memory_evolution(
            "State successor",
            "Later state.",
            &[GraphState {
                entity: "Project".to_string(),
                state: "paused".to_string(),
                valid_from: Some("2026-07-01".to_string()),
                valid_to: None,
            }],
        )?;

        assert_eq!(assessment.disposition, MemoryEvolutionDisposition::New);
        assert!(assessment.matches.is_empty());
        Ok(())
    }

    #[test]
    fn recent_conversation_turns_are_limited() -> Result<()> {
        let (_directory, db) = test_db()?;

        for index in 0..12 {
            db.append_conversation_turn(
                "test-session",
                &format!("Turn {index}"),
                &format!("Response {index}"),
            )?;
        }

        let turns = db.recent_conversation_turns("test-session", 8)?;

        assert_eq!(turns.len(), 8);

        assert_eq!(turns[0], ("Turn 4".to_string(), "Response 4".to_string()));

        assert_eq!(turns[7], ("Turn 11".to_string(), "Response 11".to_string()));

        Ok(())
    }
}

#[cfg(test)]
mod conversation_session_tests {
    use super::*;

    fn test_db() -> Result<(tempfile::TempDir, SqliteMemoryDb)> {
        let directory = tempfile::tempdir()?;

        let database = directory.path().join("test.db");

        let db = SqliteMemoryDb::open(&database)?;

        db.initialize_schema()?;

        Ok((directory, db))
    }

    #[test]
    fn conversation_sessions_are_isolated() -> Result<()> {
        let (_directory, db) = test_db()?;

        db.append_conversation_turn("session-a", "A question", "A response")?;

        db.append_conversation_turn("session-b", "B question", "B response")?;

        let a = db.recent_conversation_turns("session-a", 8)?;

        let b = db.recent_conversation_turns("session-b", 8)?;

        assert_eq!(
            a,
            vec![("A question".to_string(), "A response".to_string(),),]
        );

        assert_eq!(
            b,
            vec![("B question".to_string(), "B response".to_string(),),]
        );

        Ok(())
    }
}

#[cfg(test)]
mod task_reminder_tests {
    use super::*;
    use indexer::model::{IndexStats, NoteRecord};

    fn test_db() -> Result<(tempfile::TempDir, SqliteMemoryDb)> {
        let directory = tempfile::tempdir()?;
        let database = directory.path().join("tasks.db");
        let db = SqliteMemoryDb::open(&database)?;
        db.initialize_schema()?;
        Ok((directory, db))
    }

    fn note(
        id: &str,
        memory_kind: Option<&str>,
        task_status: Option<&str>,
        reminder_status: Option<&str>,
    ) -> NoteRecord {
        NoteRecord {
            id: id.to_string(),
            path: format!("journal/{id}.md"),
            title: id.to_string(),
            note_type: "journal".to_string(),
            namespace: "global".to_string(),
            canonical: false,
            status: "active".to_string(),
            memory_kind: memory_kind.map(str::to_string),
            task_status: task_status.map(str::to_string),
            reminder_status: reminder_status.map(str::to_string),
            checksum: format!("checksum-{id}"),
            captured_at: None,
            occurred_at: None,
            valid_from: None,
            valid_to: None,
            due_at: Some("2026-09-20T10:00:00Z".to_string()),
            updated_at: Some("2026-09-13T00:00:00Z".to_string()),
            created_at: Some("2026-09-13T00:00:00Z".to_string()),
            body: format!("# {id}\n\n{id} body."),
            entities: Vec::new(),
            relationships: Vec::new(),
            events: Vec::new(),
            states: Vec::new(),
        }
    }

    #[test]
    fn legacy_notes_schema_gains_task_reminder_columns() -> Result<()> {
        let directory = tempfile::tempdir()?;
        let database = directory.path().join("legacy-notes.db");

        {
            let connection = rusqlite::Connection::open(&database)?;
            connection.execute_batch(
                r#"
                CREATE TABLE notes (
                    id TEXT PRIMARY KEY,
                    path TEXT NOT NULL UNIQUE,
                    title TEXT NOT NULL,
                    note_type TEXT NOT NULL,
                    namespace TEXT NOT NULL,
                    canonical INTEGER NOT NULL,
                    status TEXT NOT NULL,
                    checksum TEXT NOT NULL,
                    captured_at TEXT,
                    occurred_at TEXT,
                    valid_from TEXT,
                    valid_to TEXT,
                    due_at TEXT,
                    created_at TEXT,
                    updated_at TEXT
                );
                "#,
            )?;
        }

        let db = SqliteMemoryDb::open(&database)?;
        db.initialize_schema()?;

        let columns = db
            .conn
            .prepare("PRAGMA table_info(notes)")?
            .query_map([], |row| row.get::<_, String>(1))?
            .collect::<rusqlite::Result<Vec<_>>>()?;

        assert!(columns.iter().any(|column| column == "memory_kind"));
        assert!(columns.iter().any(|column| column == "task_status"));
        assert!(columns.iter().any(|column| column == "reminder_status"));

        Ok(())
    }

    #[test]
    fn exact_task_and_reminder_lookup_returns_records_and_note_paths() -> Result<()> {
        let (_directory, mut db) = test_db()?;
        let snapshot = IndexSnapshot {
            notes: vec![
                note("task-lookup", Some("task"), Some("open"), None),
                note("reminder-lookup", Some("reminder"), None, Some("scheduled")),
            ],
            chunks: Vec::new(),
            stats: IndexStats::default(),
        };
        db.sync_snapshot(&snapshot)?;
        db.sync_semantics(&snapshot)?;

        let task = db.task("task:task-lookup")?.expect("task should exist");
        assert_eq!(task.note_id, "task-lookup");
        assert_eq!(
            db.note_path("task-lookup")?.as_deref(),
            Some("journal/task-lookup.md")
        );
        assert!(db.task("task:missing")?.is_none());

        let reminder = db
            .reminder("reminder:reminder-lookup")?
            .expect("reminder should exist");
        assert_eq!(reminder.note_id, "reminder-lookup");
        assert_eq!(
            db.note_path("reminder-lookup")?.as_deref(),
            Some("journal/reminder-lookup.md")
        );
        assert!(db.reminder("reminder:missing")?.is_none());

        Ok(())
    }

    #[test]
    fn task_and_reminder_queries_order_due_items_first() -> Result<()> {
        let (_directory, mut db) = test_db()?;
        let snapshot = IndexSnapshot {
            notes: vec![
                note("task-no-due", Some("task"), Some("open"), None),
                note("task-due", Some("task"), Some("open"), None),
                note("reminder-due", Some("reminder"), None, Some("scheduled")),
            ],
            chunks: Vec::new(),
            stats: IndexStats::default(),
        };

        // Give the due task an earlier deadline and leave the other task undated.
        let mut notes = snapshot.notes.clone();
        notes[0].due_at = None;
        notes[1].due_at = Some("2026-09-14T09:00:00Z".to_string());
        let snapshot = IndexSnapshot {
            notes,
            chunks: Vec::new(),
            stats: IndexStats::default(),
        };

        db.sync_snapshot(&snapshot)?;
        db.sync_semantics(&snapshot)?;

        let tasks = db.tasks(Some("open"), 10)?;
        assert_eq!(tasks.len(), 2);
        assert_eq!(tasks[0].id, "task:task-due");
        assert_eq!(tasks[1].id, "task:task-no-due");

        let reminders = db.reminders(Some("scheduled"), 10)?;
        assert_eq!(reminders.len(), 1);
        assert_eq!(reminders[0].id, "reminder:reminder-due");

        Ok(())
    }

    #[test]
    fn sync_semantics_derives_task_and_reminder_records() -> Result<()> {
        let (_directory, mut db) = test_db()?;
        let snapshot = IndexSnapshot {
            notes: vec![
                note("task-1", Some("task"), Some("in_progress"), None),
                note("reminder-1", Some("reminder"), None, Some("scheduled")),
            ],
            chunks: Vec::new(),
            stats: IndexStats::default(),
        };

        db.sync_snapshot(&snapshot)?;
        db.sync_semantics(&snapshot)?;

        let tasks = db.tasks(None, 10)?;
        assert_eq!(tasks.len(), 1);
        assert_eq!(tasks[0].id, "task:task-1");
        assert_eq!(tasks[0].status, "in_progress");
        assert_eq!(tasks[0].due_at.as_deref(), Some("2026-09-20T10:00:00Z"));

        let reminders = db.reminders(None, 10)?;
        assert_eq!(reminders.len(), 1);
        assert_eq!(reminders[0].id, "reminder:reminder-1");
        assert_eq!(reminders[0].status, "scheduled");

        let counts = db.semantic_counts()?;
        assert_eq!(counts.tasks, 1);
        assert_eq!(counts.reminders, 1);

        Ok(())
    }

    #[test]
    fn task_and_reminder_records_follow_source_markdown_on_resync() -> Result<()> {
        let (_directory, mut db) = test_db()?;
        let first = IndexSnapshot {
            notes: vec![note("task-1", Some("task"), Some("open"), None)],
            chunks: Vec::new(),
            stats: IndexStats::default(),
        };

        db.sync_snapshot(&first)?;
        db.sync_semantics(&first)?;
        assert_eq!(db.tasks(Some("open"), 10)?.len(), 1);

        let second = IndexSnapshot {
            notes: vec![note(
                "reminder-1",
                Some("reminder"),
                None,
                Some("completed"),
            )],
            chunks: Vec::new(),
            stats: IndexStats::default(),
        };

        db.sync_snapshot(&second)?;
        db.sync_semantics(&second)?;

        assert!(db.tasks(None, 10)?.is_empty());
        assert_eq!(db.reminders(Some("completed"), 10)?.len(), 1);

        Ok(())
    }

    #[test]
    fn invalid_task_or_reminder_status_is_rejected_during_sync() -> Result<()> {
        let (_directory, mut db) = test_db()?;
        let mut invalid_task = note("bad-task", Some("task"), Some("bogus"), None);
        let snapshot = IndexSnapshot {
            notes: vec![invalid_task.clone()],
            chunks: Vec::new(),
            stats: IndexStats::default(),
        };
        assert!(db.sync_semantics(&snapshot).is_err());

        invalid_task.memory_kind = Some("reminder".to_string());
        invalid_task.task_status = None;
        invalid_task.reminder_status = Some("bogus".to_string());
        let snapshot = IndexSnapshot {
            notes: vec![invalid_task],
            chunks: Vec::new(),
            stats: IndexStats::default(),
        };
        assert!(db.sync_semantics(&snapshot).is_err());

        Ok(())
    }
}
