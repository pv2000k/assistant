    #[test]
    fn parses_calendar_tools() -> Result<(), Box<dyn std::error::Error>> {
        let create = parse_intent(serde_json::json!({
            "kind": "call_tool",
            "tool": "calendar.create_event",
            "arguments": {
                "summary": "Project sync",
                "start": {"dateTime": "2026-09-12T18:00:00+05:30"},
                "end": {"dateTime": "2026-09-12T18:30:00+05:30"}
            }
        }))?;
        assert!(matches!(
            create.intent,
            QueryIntent::CallTool { tool, .. } if tool == "calendar.create_event"
        ));

        let update = parse_intent(serde_json::json!({
            "kind": "call_tool",
            "tool": "calendar.update_event",
            "arguments": {"event_id": "evt-1", "summary": "Renamed"}
        }))?;
        assert!(matches!(
            update.intent,
            QueryIntent::CallTool { tool, .. } if tool == "calendar.update_event"
        ));

        let list = parse_intent(serde_json::json!({
            "kind": "call_tool",
            "tool": "calendar.list_events",
            "arguments": {
                "calendar_id": "primary",
                "time_min": "2026-09-12T00:00:00Z",
                "max_results": 10
            }
        }))?;
        assert!(matches!(
            list.intent,
            QueryIntent::CallTool { tool, .. } if tool == "calendar.list_events"
        ));

        let get = parse_intent(serde_json::json!({
            "kind": "call_tool",
            "tool": "calendar.get_event",
            "arguments": {"event_id": "event-123"}
        }))?;
        assert!(matches!(
            get.intent,
            QueryIntent::CallTool { tool, arguments }
                if tool == "calendar.get_event" && arguments["event_id"] == "event-123"
        ));

        Ok(())
    }

    #[test]
    fn parses_clarification_and_model_consultation() -> Result<(), Box<dyn std::error::Error>> {
        let clarify = parse_intent(serde_json::json!({
            "kind": "clarify",
            "question": "Which Germany project do you mean?"
        }))?;
        assert!(matches!(
            clarify.intent,
            QueryIntent::Clarify { question } if question == "Which Germany project do you mean?"
        ));

        let consult = parse_intent(serde_json::json!({
            "kind": "consult_model",
            "target": "claude"
        }))?;
        assert!(matches!(
            consult.intent,
            QueryIntent::ConsultModel {
                target: ModelTarget::Claude
            }
        ));

        let invalid = parse_intent(serde_json::json!({
            "kind": "consult_model",
            "target": "qwen"
        }));
        assert!(invalid.is_err());

        Ok(())
    }

    #[test]
    fn model_selected_cloud_consultation_is_rejected() -> Result<(), Box<dyn std::error::Error>> {
        let plan = parse_intent(serde_json::json!({
            "kind": "consult_model",
            "target": "claude"
        }))?;

        let error = LlamaCppController::reject_model_selected_cloud_consultation(plan)
            .expect_err("model-generated cloud consultation should be rejected");
        assert!(
            error
                .to_string()
                .contains("Cloud model consultation requires an explicit user request")
        );

        Ok(())
    }

    #[test]
    fn explicit_cloud_consultation_is_passthrough_and_bounded()
    -> Result<(), Box<dyn std::error::Error>> {
        struct ConsultController;

        impl Controller for ConsultController {
            fn plan(
                &self,
                context: &ControllerContext,
            ) -> Result<ControllerPlan, Box<dyn std::error::Error>> {
                Ok(ControllerPlan {
                    reasoning_summary: "Delegate explicitly to Claude.".to_string(),
                    actions: vec![ControllerAction::CallModel {
                        target: ModelTarget::Claude,
                        prompt: context.request.text.clone(),
                    }],
                })
            }
        }

        struct ConsultModels;

        impl ModelExecutor for ConsultModels {
            fn execute(&self, call: &ModelCall) -> Result<ModelResult, Box<dyn std::error::Error>> {
                assert_eq!(call.target, ModelTarget::Claude);
                assert_eq!(call.prompt, "Ask Claude to review this architecture.");
                Ok(ModelResult {
                    target: ModelTarget::Claude,
                    output: "Claude response".to_string(),
                })
            }
        }

        struct NoMemory;
        impl Memory for NoMemory {
            fn search(
                &self,
                _query: &str,
                _limit: usize,
            ) -> Result<Vec<MemoryResult>, Box<dyn std::error::Error>> {
                panic!("memory should not be consulted during explicit cloud passthrough");
            }
        }

        struct NoTools;
        impl ToolExecutor for NoTools {
            fn definition(
                &self,
                _tool: &str,
            ) -> Result<tools::ToolDefinition, Box<dyn std::error::Error>> {
                panic!("tools should not be called during explicit cloud passthrough");
            }

            fn execute(&self, _call: &ToolCall) -> Result<ToolResult, Box<dyn std::error::Error>> {
                panic!("tools should not be called during explicit cloud passthrough");
            }
        }

        let orchestrator = Orchestrator {
            controller: ConsultController,
            memory: NoMemory,
            tools: NoTools,
            models: ConsultModels,
            approvals: Box::new(DenyAllApproval),
        };

        assert_eq!(
            orchestrator.run(UserRequest {
                text: "Ask Claude to review this architecture.".to_string(),
            })?,
            "Claude response"
        );

        struct UnsafeController;

        impl Controller for UnsafeController {
            fn plan(
                &self,
                _context: &ControllerContext,
            ) -> Result<ControllerPlan, Box<dyn std::error::Error>> {
                Ok(ControllerPlan {
                    reasoning_summary: "Unexpected cloud call.".to_string(),
                    actions: vec![ControllerAction::CallModel {
                        target: ModelTarget::Claude,
                        prompt: "different prompt".to_string(),
                    }],
                })
            }
        }

        let orchestrator = Orchestrator {
            controller: UnsafeController,
            memory: NoMemory,
            tools: NoTools,
            models: ConsultModels,
            approvals: Box::new(DenyAllApproval),
        };

        let error = orchestrator
            .run(UserRequest {
                text: "What is the architecture?".to_string(),
            })
            .expect_err("implicit cloud escalation should be rejected");
        assert!(
            error
                .to_string()
                .contains("Cloud escalation may only send the current user request")
        );

        Ok(())
    }

