    #[test]
    fn controller_request_separates_request_history_and_trace()
    -> Result<(), Box<dyn std::error::Error>> {
        let controller = LlamaCppController::new("http://127.0.0.1:8080", "Qwen3.5-4B-Q4_K_M.gguf");

        let context = ControllerContext {
            request: UserRequest {
                text: "CURRENT QUESTION".to_string(),
            },
            history: "USER:\nPrevious question.\n\nASSISTANT:\nPrevious answer.".to_string(),
            observations: vec![OrchestrationTrace {
                step: 0,
                action: ControllerAction::SearchMemory {
                    query: "Qwen3.5".to_string(),
                    limit: 5,
                },
                result: ActionResult::Memory {
                    results: vec![MemoryResult {
                        id: "chunk-1".to_string(),
                        text: "Memory result.".to_string(),
                        score: 0.9,
                        score_breakdown: None,
                        graph: None,
                    }],
                },
            }],
        };

        let body = controller.request_body(&context);
        let user_content = body["messages"][1]["content"]
            .as_str()
            .ok_or("controller user content was not a string")?;

        assert!(user_content.contains("CURRENT USER REQUEST:\nCURRENT QUESTION"));
        assert!(user_content.contains("CONVERSATION HISTORY:\nUSER:\nPrevious question."));
        assert!(user_content.contains("EXECUTION TRACE:"));
        assert!(user_content.contains("\"chunk-1\""));
        assert_eq!(body["response_format"]["type"], "json_schema");
        assert_eq!(body["response_format"]["json_schema"]["strict"], true);
        assert!(
            body["response_format"]["json_schema"]["schema"]["properties"]["intent"].is_object()
        );

        Ok(())
    }

    #[test]
    fn controller_context_is_bounded() -> Result<(), Box<dyn std::error::Error>> {
        let controller = LlamaCppController::new("http://127.0.0.1:8080", "Qwen3.5-4B-Q4_K_M.gguf");

        let context = ControllerContext {
            request: UserRequest {
                text: "r".repeat(MAX_CONTROLLER_REQUEST_CHARS + 100),
            },
            history: "h".repeat(MAX_CONTROLLER_HISTORY_CHARS + 1000),
            observations: vec![OrchestrationTrace {
                step: 0,
                action: ControllerAction::SearchMemory {
                    query: "q".to_string(),
                    limit: 5,
                },
                result: ActionResult::Memory {
                    results: vec![MemoryResult {
                        id: "chunk-1".to_string(),
                        text: "m".repeat(MAX_MEMORY_RESULT_TEXT_CHARS + 1000),
                        score: 0.9,
                        score_breakdown: None,
                        graph: None,
                    }],
                },
            }],
        };

        let body = controller.request_body(&context);
        let user_content = body["messages"][1]["content"]
            .as_str()
            .ok_or("controller user content was not a string")?;

        assert!(user_content.contains("CURRENT USER REQUEST:"));
        assert!(user_content.contains("CONVERSATION HISTORY:"));
        assert!(user_content.contains("EXECUTION TRACE:"));
        assert!(
            user_content.chars().count()
                <= MAX_CONTROLLER_REQUEST_CHARS
                    + MAX_CONTROLLER_HISTORY_CHARS
                    + MAX_CONTROLLER_TRACE_CHARS
                    + 100
        );

        Ok(())
    }

    #[test]
    fn generic_self_subjects_are_not_treated_as_entity_filters() {
        assert_eq!(normalize_memory_subject(Some("me".to_string())), None);
        assert_eq!(normalize_memory_subject(Some("MYSELF".to_string())), None);
        assert_eq!(normalize_memory_subject(Some("user".to_string())), None);
        assert_eq!(normalize_memory_subject(Some("self".to_string())), None);
        assert_eq!(
            normalize_memory_subject(Some("QWEN 3.5".to_string())),
            Some("QWEN 3.5".to_string())
        );
    }

