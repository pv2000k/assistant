    #[test]
    fn memory_evidence_requires_clarification_for_close_candidates() {
        let query = MemoryQuery {
            query: "Germany".to_string(),
            limit: 5,
            subject: None,
            time: None,
            mode: MemoryIntentMode::Unspecified,
        };

        let make_result = |note_id: &str, path: &str| MemoryResult {
            id: note_id.to_string(),
            text: "Germany memory candidate.".to_string(),
            score: 0.02,
            score_breakdown: Some(MemoryScoreBreakdown {
                lexical_rrf: 1.0 / 61.0,
                semantic_rrf: 1.0 / 61.0,
                rrf_score: 2.0 / 61.0,
                graph_strength: 0.0,
                graph_bonus: 0.0,
                temporal_state_bonus: 0.0,
                final_score: 2.0 / 61.0,
            }),
            graph: Some(MemoryGraphContext {
                note_id: note_id.to_string(),
                path: path.to_string(),
                entities: Vec::new(),
                relationships: Vec::new(),
                events: Vec::new(),
                states: Vec::new(),
                related_notes: Vec::new(),
            }),
        };

        let results = vec![
            make_result("note-1", "projects/masters.md"),
            make_result("note-2", "research/germany-scholarships.md"),
        ];

        let (decision, candidates) = assess_memory_query(&query, &results);

        assert_eq!(candidates.len(), 2);
        assert_eq!(decision, MemoryEvidenceDecision::Clarify);

        let clarification = memory_clarification(&query, &results).expect("clarification expected");
        assert!(clarification.contains("multiple plausible memories"));
        assert!(clarification.contains("projects/masters.md"));
        assert!(clarification.contains("research/germany-scholarships.md"));
    }

