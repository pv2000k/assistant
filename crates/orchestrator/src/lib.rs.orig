    #[test]
    fn memory_evidence_score_uses_exact_subject_and_temporal_scope() {
        let query = MemoryQuery {
            query: "Qwen3.5".to_string(),
            limit: 5,
            subject: Some("QWEN 3.5".to_string()),
            time: Some("2026-09-03".to_string()),
            mode: MemoryIntentMode::Historical,
        };

        let result = MemoryResult {
            id: "chunk-1".to_string(),
            text: "A historical Qwen memory.".to_string(),
            score: 0.03,
            score_breakdown: Some(MemoryScoreBreakdown {
                lexical_rrf: 1.0 / 61.0,
                semantic_rrf: 1.0 / 61.0,
                rrf_score: 2.0 / 61.0,
                graph_strength: 0.5,
                graph_bonus: 0.00125,
                temporal_state_bonus: 0.0,
                final_score: 0.034,
            }),
            graph: Some(MemoryGraphContext {
                note_id: "note-1".to_string(),
                path: "projects/qwen.md".to_string(),
                entities: vec![MemoryGraphEntity {
                    name: "Qwen3.5".to_string(),
                    entity_type: "model".to_string(),
                }],
                relationships: Vec::new(),
                events: Vec::new(),
                states: Vec::new(),
                related_notes: Vec::new(),
            }),
        };

        let score = memory_result_base_score(&query, &result, 0);

        assert_eq!(score.retrieval_quality, 1.0);
        assert_eq!(score.scope_fit, 1.0);
        assert!(score.total() > 0.5);
    }

