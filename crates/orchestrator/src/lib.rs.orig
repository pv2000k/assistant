    #[test]
    fn parses_memory_write_intent() -> Result<(), Box<dyn std::error::Error>> {
        let plan = parse_intent(serde_json::json!({
            "kind": "call_tool",
            "tool": "memory.write",
            "arguments": {
                "path": "journal/test.md",
                "title": "Test",
                "type": "journal",
                "body": "Saved.",
                "entities": [{"name": "Qwen3.5", "type": "technology"}],
                "relationships": [{"source": "Qwen3.5", "target": "Personal Assistant", "relationship": "used_by"}],
                "events": [{"type": "decision", "occurred_at": "2026-09-12", "entities": ["Qwen3.5"]}],
                "states": [{"entity": "Qwen3.5", "state": "selected", "valid_from": "2026-09-12"}],
                "memory_kind": "task",
                "task_status": "open",
                "due_at": "2026-09-20T10:00:00Z"
            }
        }))?;

        assert!(matches!(
            plan.intent,
            QueryIntent::CallTool { tool, arguments }
                if tool == "memory.write"
                    && arguments["path"] == "journal/test.md"
                    && arguments["entities"][0]["name"] == "Qwen3.5"
                    && arguments["relationships"][0]["relationship"] == "used_by"
                    && arguments["events"][0]["type"] == "decision"
                    && arguments["states"][0]["state"] == "selected"
                    && arguments["memory_kind"] == "task"
                    && arguments["task_status"] == "open"
                    && arguments["due_at"] == "2026-09-20T10:00:00Z"
        ));

        Ok(())
    }

