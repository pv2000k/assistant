    }

    #[test]
    fn ambiguous_memory_results_are_clarified_without_another_controller_step()
    -> Result<(), Box<dyn std::error::Error>> {
        use std::sync::atomic::{AtomicUsize, Ordering};

        struct AmbiguousController {
            calls: AtomicUsize,
        }

        impl Controller for AmbiguousController {
            fn plan(
                &self,
                context: &ControllerContext,
            ) -> Result<ControllerPlan, Box<dyn std::error::Error>> {
                self.calls.fetch_add(1, Ordering::SeqCst);

                if context.observations.is_empty() {
                    Ok(ControllerPlan {
                        reasoning_summary: "Retrieve memory.".to_string(),
                        actions: vec![ControllerAction::SearchMemoryWithQuery {
                            query: MemoryQuery {
                                query: "Germany".to_string(),
                                limit: 5,
                                subject: None,
                                time: None,
                                mode: MemoryIntentMode::Unspecified,
                            },
                        }],
                    })
                } else {
                    Err("controller should not be called after ambiguity is detected".into())
                }
            }
        }

        struct AmbiguousMemory;

        impl Memory for AmbiguousMemory {
            fn search(
                &self,
                _query: &str,
                _limit: usize,
            ) -> Result<Vec<MemoryResult>, Box<dyn std::error::Error>> {
                Ok(Vec::new())
            }

            fn search_with_query(
                &self,
                _query: &MemoryQuery,
            ) -> Result<Vec<MemoryResult>, Box<dyn std::error::Error>> {
                let make_result = |id: &str, path: &str| MemoryResult {
                    id: id.to_string(),
                    text: "Germany memory candidate.".to_string(),
                    score: 0.02,
                    score_breakdown: Some(MemoryScoreBreakdown {
                        lexical_rrf: 1.0 / 61.0,
                        semantic_rrf: 1.0 / 61.0,
                        rrf_score: 2.0 / 61.0,
                        graph_strength: 0.0,
                        graph_bonus: 0.0,
                        temporal_state_bonus: 0.0,
                        final_score: 2.0 / 61.0,
                    }),
                    graph: Some(MemoryGraphContext {
                        note_id: id.to_string(),
                        path: path.to_string(),
                        entities: Vec::new(),
                        relationships: Vec::new(),
                        events: Vec::new(),
                        states: Vec::new(),
                        related_notes: Vec::new(),
                    }),
                };

                Ok(vec![
                    make_result("note-1", "projects/masters.md"),
                    make_result("note-2", "research/germany-scholarships.md"),
                ])
            }
        }

        struct NoTools;
        impl ToolExecutor for NoTools {
            fn definition(
                &self,
                _tool: &str,
            ) -> Result<tools::ToolDefinition, Box<dyn std::error::Error>> {
                Err("tools should not be called".into())
            }

            fn execute(&self, _call: &ToolCall) -> Result<ToolResult, Box<dyn std::error::Error>> {
                Err("tools should not be called".into())
            }
        }

        struct NoModels;
        impl ModelExecutor for NoModels {
            fn execute(
                &self,
                _call: &ModelCall,
            ) -> Result<ModelResult, Box<dyn std::error::Error>> {
                Err("models should not be called".into())
            }
        }

        let controller = AmbiguousController {
            calls: AtomicUsize::new(0),
        };

        let orchestrator = Orchestrator {
            controller,
            memory: AmbiguousMemory,
            tools: NoTools,
            models: NoModels,
            approvals: Box::new(DenyAllApproval),
        };

        let response = orchestrator.run(UserRequest {
            text: "Handle the Germany thing.".to_string(),
        })?;

        assert!(response.contains("multiple plausible memories"));
        assert!(response.contains("projects/masters.md"));
        assert!(response.contains("research/germany-scholarships.md"));
        assert_eq!(orchestrator.controller.calls.load(Ordering::SeqCst), 1);

        Ok(())
    }

    #[test]
    fn memory_context_selection_limits_redundant_evidence() -> Result<(), Box<dyn std::error::Error>>
    {
        struct ContextController;

        impl Controller for ContextController {
            fn plan(
                &self,
                context: &ControllerContext,
            ) -> Result<ControllerPlan, Box<dyn std::error::Error>> {
                if context.observations.is_empty() {
                    Ok(ControllerPlan {
                        reasoning_summary: "Retrieve memory.".to_string(),
                        actions: vec![ControllerAction::SearchMemoryWithQuery {
                            query: MemoryQuery {
                                query: "project".to_string(),
                                limit: 10,
                                subject: None,
                                time: None,
                                mode: MemoryIntentMode::Unspecified,
                            },
                        }],
                    })
                } else {
                    Err("controller should not be called after memory retrieval synthesis".into())
                }
            }
        }

        struct ContextMemory;

        impl Memory for ContextMemory {
            fn search(
                &self,
                _query: &str,
                _limit: usize,
            ) -> Result<Vec<MemoryResult>, Box<dyn std::error::Error>> {
                Ok(Vec::new())
            }

            fn search_with_query(
                &self,
                _query: &MemoryQuery,
            ) -> Result<Vec<MemoryResult>, Box<dyn std::error::Error>> {
                let make_result = |id: &str,
                                   note_id: &str,
                                   score: f64,
                                   graph_strength: f64,
                                   related_count: usize| {
                    MemoryResult {
                        id: id.to_string(),
                        text: id.to_string(),
                        score,
                        score_breakdown: Some(MemoryScoreBreakdown {
                            lexical_rrf: score,
                            semantic_rrf: 0.0,
                            rrf_score: score,
                            graph_strength,
                            graph_bonus: 0.0,
                            temporal_state_bonus: 0.0,
                            final_score: score,
                        }),
                        graph: Some(MemoryGraphContext {
                            note_id: note_id.to_string(),
                            path: format!("{note_id}.md"),
                            entities: Vec::new(),
                            relationships: Vec::new(),
                            events: Vec::new(),
                            states: Vec::new(),
                            related_notes: (0..related_count)
                                .map(|index| MemoryGraphRelatedNote {
                                    note_id: format!("{note_id}-related-{index}"),
                                    path: format!("{note_id}-related-{index}.md"),
                                    shared_entities: Vec::new(),
                                    entities: Vec::new(),
                                    relationships: Vec::new(),
                                    events: Vec::new(),
                                    states: Vec::new(),
                                })
                                .collect(),
                        }),
                    }
                };

                Ok(vec![
                    make_result("top-a", "note-top", 2.0 / 61.0, 1.0, 3),
                    make_result("top-b", "note-top", 1.9 / 61.0, 1.0, 3),
                    make_result("second-a", "note-second", 1.0 / 61.0, 0.0, 0),
                    make_result("third-a", "note-third", 0.9 / 61.0, 0.0, 0),
                    make_result("fourth-a", "note-fourth", 0.8 / 61.0, 0.0, 0),
                ])
            }
        }

        struct NoTools;

        impl ToolExecutor for NoTools {
            fn definition(
                &self,
                _tool: &str,
            ) -> Result<tools::ToolDefinition, Box<dyn std::error::Error>> {
                Err("tools should not be called".into())
            }

            fn execute(&self, _call: &ToolCall) -> Result<ToolResult, Box<dyn std::error::Error>> {
                Err("tools should not be called".into())
            }
        }

        struct SynthesisModels;

        impl ModelExecutor for SynthesisModels {
            fn execute(&self, call: &ModelCall) -> Result<ModelResult, Box<dyn std::error::Error>> {
                assert_eq!(call.target, ModelTarget::Qwen);
                assert!(
                    call.prompt
                        .contains("USER REQUEST:\nTell me about the project.")
                );
                assert!(call.prompt.contains("[1] source: note-top.md\ntext: top-a"));
                assert!(call.prompt.contains("[2] source: note-top.md\ntext: top-b"));
                assert!(
                    call.prompt
                        .contains("[3] source: note-second.md\ntext: second-a")
                );
                assert!(
                    call.prompt
                        .contains("[4] source: note-third.md\ntext: third-a")
                );
                assert!(!call.prompt.contains("fourth-a"));

                Ok(ModelResult {
                    target: ModelTarget::Qwen,
                    output: "synthesized".to_string(),
                })
            }
        }

        let orchestrator = Orchestrator {
            controller: ContextController,
            memory: ContextMemory,
            tools: NoTools,
            models: SynthesisModels,
            approvals: Box::new(DenyAllApproval),
        };

        assert_eq!(
            orchestrator.run(UserRequest {
                text: "Tell me about the project.".to_string(),
            })?,
            "synthesized"
        );

        Ok(())
    }

    #[test]
    fn memory_context_selection_preserves_candidate_coverage()
    -> Result<(), Box<dyn std::error::Error>> {
        let query = MemoryQuery {
            query: "project".to_string(),
            limit: 10,
            subject: None,
            time: None,
            mode: MemoryIntentMode::Unspecified,
        };

        let make_result = |id: &str, note_id: &str, score: f64| MemoryResult {
            id: id.to_string(),
            text: id.to_string(),
            score,
            score_breakdown: Some(MemoryScoreBreakdown {
                lexical_rrf: score,
                semantic_rrf: 0.0,
                rrf_score: score,
                graph_strength: if note_id == "note-top" { 1.0 } else { 0.0 },
                graph_bonus: 0.0,
                temporal_state_bonus: 0.0,
                final_score: score,
            }),
            graph: Some(MemoryGraphContext {
                note_id: note_id.to_string(),
                path: format!("{note_id}.md"),
                entities: Vec::new(),
                relationships: Vec::new(),
                events: Vec::new(),
                states: Vec::new(),
                related_notes: Vec::new(),
            }),
        };

        let results = vec![
            make_result("top-a", "note-top", 2.0 / 61.0),
            make_result("top-b", "note-top", 1.9 / 61.0),
            make_result("top-c", "note-top", 1.8 / 61.0),
            make_result("top-d", "note-top", 1.7 / 61.0),
            make_result("second-a", "note-second", 1.0 / 61.0),
            make_result("third-a", "note-third", 0.9 / 61.0),
        ];

        let selected = select_memory_context_results(&query, &results);
        let selected_ids = selected
            .iter()
            .map(|result| result.id.as_str())
            .collect::<std::collections::BTreeSet<_>>();

        assert_eq!(selected.len(), MEMORY_CONTEXT_MAX_RESULTS);
        assert!(selected_ids.contains("top-a"));
        assert!(selected_ids.contains("top-b"));
        assert!(selected_ids.contains("second-a"));
        assert!(selected_ids.contains("third-a"));
        assert!(!selected_ids.contains("top-d"));

        Ok(())
    }

    #[test]
    fn memory_context_selection_preserves_multiple_chunks_from_best_note()
    -> Result<(), Box<dyn std::error::Error>> {
        let query = MemoryQuery {
            query: "project".to_string(),
            limit: 10,
            subject: None,
            time: None,
            mode: MemoryIntentMode::Unspecified,
        };

        let make_result = |id: &str, note_id: &str, score: f64| MemoryResult {
            id: id.to_string(),
            text: id.to_string(),
            score,
            score_breakdown: Some(MemoryScoreBreakdown {
                lexical_rrf: score,
                semantic_rrf: 0.0,
                rrf_score: score,
                graph_strength: 0.0,
                graph_bonus: 0.0,
                temporal_state_bonus: 0.0,
                final_score: score,
            }),
            graph: Some(MemoryGraphContext {
                note_id: note_id.to_string(),
                path: format!("{note_id}.md"),
                entities: Vec::new(),
                relationships: Vec::new(),
                events: Vec::new(),
                states: Vec::new(),
                related_notes: Vec::new(),
            }),
        };

        let results = vec![
            make_result("best-1", "note-best", 2.0 / 61.0),
            make_result("best-2", "note-best", 1.9 / 61.0),
            make_result("best-3", "note-best", 1.8 / 61.0),
            make_result("supporting", "note-supporting", 1.7 / 61.0),
            make_result("discarded", "note-discarded", 1.6 / 61.0),
        ];

        let selected = select_memory_context_results(&query, &results);

        assert_eq!(selected.len(), MEMORY_CONTEXT_MAX_RESULTS);
        assert!(selected.iter().any(|result| result.id == "best-1"));
        assert!(selected.iter().any(|result| result.id == "best-2"));
        assert!(selected.iter().any(|result| result.id == "best-3"));
        assert!(selected.iter().any(|result| result.id == "supporting"));
        assert!(selected.iter().all(|result| result.id != "discarded"));

        Ok(())
    }

    #[test]
    fn structured_memory_query_reaches_memory_executor() -> Result<(), Box<dyn std::error::Error>> {
        use std::sync::Mutex;

        struct RecordingMemory {
            query: Mutex<Option<MemoryQuery>>,
        }

        impl Memory for RecordingMemory {
            fn search(
                &self,
                _query: &str,
                _limit: usize,
            ) -> Result<Vec<MemoryResult>, Box<dyn std::error::Error>> {
                Ok(Vec::new())
            }

            fn search_with_query(
                &self,
                query: &MemoryQuery,
            ) -> Result<Vec<MemoryResult>, Box<dyn std::error::Error>> {
                *self.query.lock().expect("memory mutex poisoned") = Some(query.clone());
                Ok(Vec::new())
            }
        }

        struct NoTools;

        impl ToolExecutor for NoTools {
            fn definition(
                &self,
                _tool: &str,
            ) -> Result<tools::ToolDefinition, Box<dyn std::error::Error>> {
                Err("tool definition should not be requested".into())
            }

            fn execute(&self, _call: &ToolCall) -> Result<ToolResult, Box<dyn std::error::Error>> {
                Err("tool should not be executed".into())
            }
        }

        struct QueryController;

        impl Controller for QueryController {
            fn plan(
                &self,
                context: &ControllerContext,
            ) -> Result<ControllerPlan, Box<dyn std::error::Error>> {
                if context.observations.is_empty() {
                    Ok(ControllerPlan {
                        reasoning_summary: "Retrieve memory.".to_string(),
                        actions: vec![ControllerAction::SearchMemoryWithQuery {
                            query: MemoryQuery {
                                query: "large local models".to_string(),
                                limit: 7,
                                subject: Some("Qwen3.5".to_string()),
                                time: Some("2026-09-03".to_string()),
                                mode: MemoryIntentMode::Historical,
                            },
                        }],
                    })
                } else {
                    Ok(ControllerPlan {
                        reasoning_summary: "Respond.".to_string(),
                        actions: vec![ControllerAction::Respond {
                            text: "Done.".to_string(),
                        }],
                    })
                }
            }
        }

        struct NoModels;

        impl ModelExecutor for NoModels {
            fn execute(
                &self,
                _call: &ModelCall,
            ) -> Result<ModelResult, Box<dyn std::error::Error>> {
                Err("models should not be called".into())
            }
        }

        let memory = RecordingMemory {
            query: Mutex::new(None),
        };

        let orchestrator = Orchestrator {
            controller: QueryController,
            memory,
            tools: NoTools,
            models: NoModels,
            approvals: Box::new(DenyAllApproval),
        };

        assert_eq!(
            orchestrator.run(UserRequest {
                text: "Where was I on September 3?".to_string(),
            })?,
            "Done."
        );

        let recorded = orchestrator
            .memory
            .query
            .lock()
            .expect("memory mutex poisoned")
            .clone()
            .ok_or("memory query was not recorded")?;

        assert_eq!(recorded.query, "large local models");
        assert_eq!(recorded.limit, 7);
        assert_eq!(recorded.subject.as_deref(), Some("Qwen3.5"));
        assert_eq!(recorded.time.as_deref(), Some("2026-09-03"));
        assert_eq!(recorded.mode, MemoryIntentMode::Historical);

        Ok(())
    }

    #[test]
    fn clarification_maps_to_response_action() -> Result<(), Box<dyn std::error::Error>> {
        let plan = parse_intent(serde_json::json!({
            "kind": "clarify",
            "question": "Which project do you mean?"
        }))?;

        let controller_plan = LlamaCppController::query_plan_to_action(plan, "What happened?");

        assert!(matches!(
            controller_plan.actions.first(),
            Some(ControllerAction::Respond { text }) if text == "Which project do you mean?"
        ));

        Ok(())
    }

    #[test]
    fn parses_task_and_reminder_tool_arguments() -> Result<(), Box<dyn std::error::Error>> {
        let task = parse_intent(serde_json::json!({
            "kind": "call_tool",
            "tool": "tasks.list",
            "arguments": {"status": "open", "due": "tomorrow", "limit": 10}
        }))?;
        assert!(
            matches!(task.intent, QueryIntent::CallTool { ref tool, .. } if tool == "tasks.list")
        );

        let reminder = parse_intent(serde_json::json!({
            "kind": "call_tool",
            "tool": "reminders.mutate",
            "arguments": {
                "operation": "create",
                "title": "Submit application",
                "due": "tomorrow at 6 PM",
                "calendar_sync": true
            }
        }))?;
        assert!(
            matches!(reminder.intent, QueryIntent::CallTool { ref tool, .. } if tool == "reminders.mutate")
        );

        Ok(())
    }

    #[test]
    fn rejects_malformed_task_reminder_arguments() -> Result<(), Box<dyn std::error::Error>> {
        for arguments in [
            serde_json::json!({"operation": "update", "id": "task:1"}),
            serde_json::json!({"operation": "complete", "id": "task:1", "due": "tomorrow"}),
            serde_json::json!({"operation": "create", "title": "x", "status": "completed"}),
            serde_json::json!({"operation": "delete", "id": "task:1"}),
        ] {
            let result = parse_intent(serde_json::json!({
                "kind": "call_tool",
                "tool": "tasks.mutate",
                "arguments": arguments
            }));
            assert!(result.is_err());
        }

        let extra = parse_intent(serde_json::json!({
            "kind": "call_tool",
            "tool": "reminders.list",
            "arguments": {"unknown": true}
        }));
        assert!(extra.is_err());

        let invalid_calendar_sync = parse_intent(serde_json::json!({
            "kind": "call_tool",
            "tool": "reminders.mutate",
            "arguments": {
                "operation": "create",
                "title": "x",
                "calendar_sync": "yes"
            }
        }));
        assert!(invalid_calendar_sync.is_err());

        let task_calendar_sync = parse_intent(serde_json::json!({
            "kind": "call_tool",
            "tool": "tasks.mutate",
            "arguments": {
                "operation": "create",
                "title": "x",
                "calendar_sync": true
            }
        }));
        assert!(task_calendar_sync.is_err());

        Ok(())
    }

    #[test]
    fn rejects_invalid_tool_arguments() -> Result<(), Box<dyn std::error::Error>> {
        let missing_times = serde_json::json!({
            "kind": "call_tool",
            "tool": "calendar.create_event",
            "arguments": {"summary": "Missing time"}
        });
        assert!(parse_intent(missing_times).is_err());

        let empty_update = serde_json::json!({
            "kind": "call_tool",
            "tool": "calendar.update_event",
            "arguments": {"event_id": "evt-1"}
        });
        assert!(parse_intent(empty_update).is_err());

        let delete = serde_json::json!({
            "kind": "call_tool",
            "tool": "calendar.delete_event",
            "arguments": {"event_id": "evt-1"}
        });
        assert!(parse_intent(delete).is_err());

        let too_many = serde_json::json!({
            "kind": "call_tool",
            "tool": "calendar.list_events",
            "arguments": {"max_results": 51}
        });
        assert!(parse_intent(too_many).is_err());

        let missing_id = serde_json::json!({
            "kind": "call_tool",
            "tool": "calendar.get_event",
            "arguments": {}
        });
        assert!(parse_intent(missing_id).is_err());

        Ok(())
    }

    #[test]
    fn rejects_memory_search_as_tool_and_model_approval_metadata()
    -> Result<(), Box<dyn std::error::Error>> {
        let memory_as_tool = serde_json::json!({
            "kind": "call_tool",
            "tool": "search_memory",
            "arguments": {}
        });
        assert!(parse_intent(memory_as_tool).is_err());

        let approval_metadata = serde_json::json!({
            "kind": "call_tool",
            "tool": "files.read",
            "arguments": {"path": "test.txt"},
            "requires_approval": true
        });
        assert!(parse_intent(approval_metadata).is_err());

        Ok(())
    }

    #[test]
    fn rejects_legacy_action_and_unknown_query_fields() -> Result<(), Box<dyn std::error::Error>> {
        let legacy = serde_json::json!({
            "reasoning_summary": "Legacy action plan.",
            "actions": [{
                "action": "search_memory",
                "query": "Qwen3.5"
            }]
        });
        assert!(LlamaCppController::parse_query_plan(&legacy.to_string()).is_err());

        let extra_top_level = serde_json::json!({
            "reasoning_summary": "Invalid.",
            "intent": {"kind": "respond", "text": "hello"},
            "actions": []
        });
        assert!(LlamaCppController::parse_query_plan(&extra_top_level.to_string()).is_err());

        let extra_intent = serde_json::json!({
            "reasoning_summary": "Invalid.",
            "intent": {
                "kind": "respond",
                "text": "hello",
                "extra": true
            }
        });
        assert!(LlamaCppController::parse_query_plan(&extra_intent.to_string()).is_err());

        Ok(())
    }

    #[test]
    fn parses_query_plan_from_fenced_json() -> Result<(), Box<dyn std::error::Error>> {
        let content = r#"```json
{
  "reasoning_summary": "Retrieve the relevant memory.",
  "intent": {
    "kind": "retrieve_memory",
    "query": "Qwen3.5",
    "limit": 5,
    "subject": "Qwen3.5",
    "time": null,
    "mode": "current"
  }
}
```"#;

        let plan = LlamaCppController::parse_query_plan(content)?;

        assert!(matches!(
            plan.intent,
            QueryIntent::RetrieveMemory {
                query,
                mode: MemoryIntentMode::Current,
                ..
            } if query == "Qwen3.5"
        ));

        Ok(())
    }
}

pub struct SqliteMemory {
    db: sqlite_memory::SqliteMemoryDb,
}

impl SqliteMemory {
    pub fn open(path: impl AsRef<std::path::Path>) -> Result<Self, Box<dyn std::error::Error>> {
        let db = sqlite_memory::SqliteMemoryDb::open(path)?;

        Ok(Self { db })
    }

    pub fn initialize_schema(&self) -> Result<(), Box<dyn std::error::Error>> {
        self.db.initialize_schema()?;
        Ok(())
    }

    pub fn database(&self) -> &sqlite_memory::SqliteMemoryDb {
        &self.db
    }
}

impl Memory for SqliteMemory {
    fn search(
        &self,
        query: &str,
        limit: usize,
    ) -> Result<Vec<MemoryResult>, Box<dyn std::error::Error>> {
        let results = self.db.search(query, i64::try_from(limit)?)?;

        Ok(results
            .into_iter()
            .map(|(id, text, score)| MemoryResult {
                id,
                text,
                score,
                score_breakdown: None,
                graph: None,
            })
            .collect())
    }
}

#[cfg(test)]
mod loop_guard_tests {
    use super::*;
    use std::sync::atomic::{AtomicUsize, Ordering};

    struct RepeatingController {
        calls: AtomicUsize,
    }

    impl Controller for RepeatingController {
        fn plan(
            &self,
            _context: &ControllerContext,
        ) -> Result<ControllerPlan, Box<dyn std::error::Error>> {
            self.calls.fetch_add(1, Ordering::SeqCst);

            Ok(ControllerPlan {
                reasoning_summary: "Repeat memory search.".to_string(),
                actions: vec![ControllerAction::SearchMemory {
                    query: "Qwen3.5".to_string(),
                    limit: 5,
                }],
            })
        }
    }

    struct EmptyMemory;

    impl Memory for EmptyMemory {
        fn search(
            &self,
            _query: &str,
            _limit: usize,
        ) -> Result<Vec<MemoryResult>, Box<dyn std::error::Error>> {
            Ok(Vec::new())
        }
    }

    struct DisabledTools;

    impl ToolExecutor for DisabledTools {
        fn definition(
            &self,
            _tool: &str,
        ) -> Result<tools::ToolDefinition, Box<dyn std::error::Error>> {
            Err("Tool definition should not be requested.".into())
        }

        fn execute(&self, _call: &ToolCall) -> Result<ToolResult, Box<dyn std::error::Error>> {
            Err("Tool executor should not be called.".into())
        }
    }

    struct DisabledModels;

    impl ModelExecutor for DisabledModels {
        fn execute(&self, _call: &ModelCall) -> Result<ModelResult, Box<dyn std::error::Error>> {
            Err("Model executor should not be called.".into())
        }
    }

    #[test]
    fn repeated_memory_search_is_rejected() -> Result<(), Box<dyn std::error::Error>> {
        let controller = RepeatingController {
            calls: AtomicUsize::new(0),
        };

        let orchestrator = Orchestrator {
            controller,
            memory: EmptyMemory,
            tools: DisabledTools,
            models: DisabledModels,
            approvals: Box::new(DenyAllApproval),
        };

        let result = orchestrator.run(UserRequest {
            text: "What do you remember about Qwen3.5?".to_string(),
        });

        assert!(result.is_err());

        Ok(())
    }
}

pub struct HybridMemory {
    db: sqlite_memory::SqliteMemoryDb,
    embedder: embedding::LlamaCppEmbedder,
}

impl HybridMemory {
    pub fn open(
        path: impl AsRef<std::path::Path>,
        embedding_url: impl Into<String>,
        embedding_model: impl Into<String>,
    ) -> Result<Self, Box<dyn std::error::Error>> {
        let db = sqlite_memory::SqliteMemoryDb::open(path)?;

        db.initialize_schema()?;
        db.initialize_vector_index(384)?;

        let embedder = embedding::LlamaCppEmbedder::new(embedding_url, embedding_model);

        Ok(Self { db, embedder })
    }

    pub fn database(&self) -> &sqlite_memory::SqliteMemoryDb {
        &self.db
    }
}

impl Memory for HybridMemory {
    fn search_with_query(
        &self,
        query: &MemoryQuery,
    ) -> Result<Vec<MemoryResult>, Box<dyn std::error::Error>> {
        if query.limit == 0 {
            return Ok(Vec::new());
        }

        let temporal_mode = match query.mode {
            MemoryIntentMode::Current => sqlite_memory::HybridTemporalMode::Current,
            MemoryIntentMode::Historical => sqlite_memory::HybridTemporalMode::Historical,
            MemoryIntentMode::Future => sqlite_memory::HybridTemporalMode::Future,
            MemoryIntentMode::Unspecified => sqlite_memory::HybridTemporalMode::Unspecified,
        };

        let query_embedding = self.embedder.embed(&query.query)?;
        let limit_i64 = i64::try_from(query.limit)?;
        let candidate_limit = i64::try_from(query.limit.saturating_mul(4).max(query.limit))?;

        let results = self.db.hybrid_search_with_graph_scoped(
            &query.query,
            &query_embedding,
            limit_i64,
            candidate_limit,
            query.subject.as_deref(),
            query.time.as_deref(),
            temporal_mode,
        )?;

        Ok(results
            .into_iter()
            .map(|result| MemoryResult {
                id: result.chunk_id,
                text: result.text,
                score: result.score,
                score_breakdown: Some(MemoryScoreBreakdown {
                    lexical_rrf: result.score_breakdown.lexical_rrf,
                    semantic_rrf: result.score_breakdown.semantic_rrf,
                    rrf_score: result.score_breakdown.rrf_score,
                    graph_strength: result.score_breakdown.graph_strength,
                    graph_bonus: result.score_breakdown.graph_bonus,
                    temporal_state_bonus: result.score_breakdown.temporal_state_bonus,
                    final_score: result.score_breakdown.final_score,
                }),
                graph: Some(MemoryGraphContext {
                    note_id: result.graph.note_id,
                    path: result.graph.path,
                    entities: result
                        .graph
                        .entities
                        .into_iter()
                        .map(|entity| MemoryGraphEntity {
                            name: entity.name,
                            entity_type: entity.entity_type,
                        })
                        .collect(),
                    relationships: result
                        .graph
                        .relationships
                        .into_iter()
                        .map(|relationship| MemoryGraphRelationship {
                            source: relationship.source,
                            relationship: relationship.relationship,
                            target: relationship.target,
                        })
                        .collect(),
                    events: result
                        .graph
                        .events
                        .into_iter()
                        .map(|event| MemoryGraphEvent {
                            event_type: event.event_type,
                            occurred_at: event.occurred_at,
                            description: event.description,
                            entities: event.entities,
                        })
                        .collect(),
                    states: result
                        .graph
                        .states
                        .into_iter()
                        .map(|state| MemoryGraphState {
                            entity: state.entity,
                            state: state.state,
                            valid_from: state.valid_from,
                            valid_to: state.valid_to,
                        })
                        .collect(),
                    related_notes: result
                        .graph
                        .related_notes
                        .into_iter()
                        .map(|note| MemoryGraphRelatedNote {
                            note_id: note.note_id,
                            path: note.path,
                            shared_entities: note.shared_entities,
                            entities: note
                                .entities
                                .into_iter()
                                .map(|entity| MemoryGraphEntity {
                                    name: entity.name,
                                    entity_type: entity.entity_type,
                                })
                                .collect(),
                            relationships: note
                                .relationships
                                .into_iter()
                                .map(|relationship| MemoryGraphRelationship {
                                    source: relationship.source,
                                    relationship: relationship.relationship,
                                    target: relationship.target,
                                })
                                .collect(),
                            events: note
                                .events
                                .into_iter()
                                .map(|event| MemoryGraphEvent {
                                    event_type: event.event_type,
                                    occurred_at: event.occurred_at,
                                    description: event.description,
                                    entities: event.entities,
                                })
                                .collect(),
                            states: note
                                .states
                                .into_iter()
                                .map(|state| MemoryGraphState {
                                    entity: state.entity,
                                    state: state.state,
                                    valid_from: state.valid_from,
                                    valid_to: state.valid_to,
                                })
                                .collect(),
                        })
                        .collect(),
                }),
            })
            .collect())
    }

    fn search(
        &self,
        query: &str,
        limit: usize,
    ) -> Result<Vec<MemoryResult>, Box<dyn std::error::Error>> {
        if limit == 0 {
            return Ok(Vec::new());
        }

        let query_embedding = self.embedder.embed(query)?;

        let limit_i64 = i64::try_from(limit)?;

        let candidate_limit = i64::try_from(limit.saturating_mul(4).max(limit))?;

        let results = self.db.hybrid_search_with_graph(
            query,
            &query_embedding,
            limit_i64,
            candidate_limit,
        )?;

        Ok(results
            .into_iter()
            .map(|result| MemoryResult {
                id: result.chunk_id,
                text: result.text,
                score: result.score,
                score_breakdown: Some(MemoryScoreBreakdown {
                    lexical_rrf: result.score_breakdown.lexical_rrf,
                    semantic_rrf: result.score_breakdown.semantic_rrf,
                    rrf_score: result.score_breakdown.rrf_score,
                    graph_strength: result.score_breakdown.graph_strength,
                    graph_bonus: result.score_breakdown.graph_bonus,
                    temporal_state_bonus: result.score_breakdown.temporal_state_bonus,
                    final_score: result.score_breakdown.final_score,
                }),
                graph: Some(MemoryGraphContext {
                    note_id: result.graph.note_id,
                    path: result.graph.path,
                    entities: result
                        .graph
                        .entities
                        .into_iter()
                        .map(|entity| MemoryGraphEntity {
                            name: entity.name,
                            entity_type: entity.entity_type,
                        })
                        .collect(),
                    relationships: result
                        .graph
                        .relationships
                        .into_iter()
                        .map(|relationship| MemoryGraphRelationship {
                            source: relationship.source,
                            relationship: relationship.relationship,
                            target: relationship.target,
                        })
                        .collect(),
                    events: result
                        .graph
                        .events
                        .into_iter()
                        .map(|event| MemoryGraphEvent {
                            event_type: event.event_type,
                            occurred_at: event.occurred_at,
                            description: event.description,
                            entities: event.entities,
                        })
                        .collect(),
                    states: result
                        .graph
                        .states
                        .into_iter()
                        .map(|state| MemoryGraphState {
                            entity: state.entity,
                            state: state.state,
                            valid_from: state.valid_from,
                            valid_to: state.valid_to,
                        })
                        .collect(),
                    related_notes: result
                        .graph
                        .related_notes
                        .into_iter()
                        .map(|note| MemoryGraphRelatedNote {
                            note_id: note.note_id,
                            path: note.path,
                            shared_entities: note.shared_entities,
                            entities: note
                                .entities
                                .into_iter()
                                .map(|entity| MemoryGraphEntity {
                                    name: entity.name,
                                    entity_type: entity.entity_type,
                                })
                                .collect(),
                            relationships: note
                                .relationships
                                .into_iter()
                                .map(|relationship| MemoryGraphRelationship {
                                    source: relationship.source,
                                    relationship: relationship.relationship,
                                    target: relationship.target,
                                })
                                .collect(),
                            events: note
                                .events
                                .into_iter()
                                .map(|event| MemoryGraphEvent {
                                    event_type: event.event_type,
                                    occurred_at: event.occurred_at,
                                    description: event.description,
                                    entities: event.entities,
                                })
                                .collect(),
                            states: note
                                .states
                                .into_iter()
                                .map(|state| MemoryGraphState {
                                    entity: state.entity,
                                    state: state.state,
                                    valid_from: state.valid_from,
                                    valid_to: state.valid_to,
                                })
                                .collect(),
                        })
                        .collect(),
                }),
            })
            .collect())
    }
}

pub struct RegistryToolExecutor {
    registry: tools::ToolRegistry,
}

impl RegistryToolExecutor {
    pub fn new(registry: tools::ToolRegistry) -> Self {
        Self { registry }
    }

    pub fn registry(&self) -> &tools::ToolRegistry {
        &self.registry
    }
}

impl ToolExecutor for RegistryToolExecutor {
    fn definition(&self, tool: &str) -> Result<tools::ToolDefinition, Box<dyn std::error::Error>> {
        Ok(self.registry.definition(tool)?)
    }

    fn execute(&self, call: &ToolCall) -> Result<ToolResult, Box<dyn std::error::Error>> {
        let result = self.registry.execute(&tools::ToolCall {
            tool: call.tool.clone(),
            arguments: call.arguments.clone(),
        })?;

        Ok(ToolResult {
            success: result.success,
            output: result.output,
        })
    }
}

#[cfg(test)]
mod approval_flow_tests {

    #[test]
    fn multi_step_file_navigation_works() -> Result<(), Box<dyn std::error::Error>> {
        struct MultiStepController {
            step: AtomicUsize,
        }

        impl Controller for MultiStepController {
            fn plan(
                &self,
                _context: &ControllerContext,
            ) -> Result<ControllerPlan, Box<dyn std::error::Error>> {
                let step = self.step.fetch_add(1, Ordering::SeqCst);

                let action = match step {
                    0 => ControllerAction::CallTool {
                        tool: "files.list".to_string(),
                        arguments: serde_json::json!({
                            "path": ".",
                            "recursive": false,
                            "limit": 100
                        }),
                    },

                    1 => ControllerAction::CallTool {
                        tool: "files.read".to_string(),
                        arguments: serde_json::json!({
                            "path": "hello.txt"
                        }),
                    },

                    _ => ControllerAction::Respond {
                        text: "Found and read the file.".to_string(),
                    },
                };

                Ok(ControllerPlan {
                    reasoning_summary: "Continue the file navigation.".to_string(),
                    actions: vec![action],
                })
            }
        }

        struct MultiStepTools;

        impl ToolExecutor for MultiStepTools {
            fn definition(
                &self,
                tool: &str,
            ) -> Result<tools::ToolDefinition, Box<dyn std::error::Error>> {
                let permission = match tool {
                    "files.list" | "files.read" => tools::ToolPermission::ReadOnly,
                    other => return Err(format!("Unexpected tool definition: {other}").into()),
                };

                Ok(tools::ToolDefinition {
                    name: tool.to_string(),
                    description: "Test tool".to_string(),
                    permission,
                })
            }

            fn execute(&self, call: &ToolCall) -> Result<ToolResult, Box<dyn std::error::Error>> {
                match call.tool.as_str() {
                    "files.list" => Ok(ToolResult {
                        success: true,
                        output: serde_json::json!({
                            "entries": [
                                {
                                    "path": "hello.txt",
                                    "type": "file"
                                }
                            ]
                        }),
                    }),

                    "files.read" => Ok(ToolResult {
                        success: true,
                        output: serde_json::json!({
                            "path": "hello.txt",
                            "text": "hello"
                        }),
                    }),

                    other => Err(format!("Unexpected tool: {other}").into()),
                }
            }
        }

        struct EmptyMemory;

        impl Memory for EmptyMemory {
            fn search(
                &self,
                _query: &str,
                _limit: usize,
            ) -> Result<Vec<MemoryResult>, Box<dyn std::error::Error>> {
                Ok(Vec::new())
            }
        }

        struct EmptyModels;

        impl ModelExecutor for EmptyModels {
            fn execute(
                &self,
                _call: &ModelCall,
            ) -> Result<ModelResult, Box<dyn std::error::Error>> {
                Err("Models disabled.".into())
            }
        }

        let orchestrator = Orchestrator {
            controller: MultiStepController {
                step: AtomicUsize::new(0),
            },
            memory: EmptyMemory,
            tools: MultiStepTools,
            models: EmptyModels,
            approvals: Box::new(DenyAllApproval),
        };

        let response = orchestrator.run(UserRequest {
            text: "Find and read hello.txt.".to_string(),
        })?;

        assert_eq!(response, "Found and read the file.");

        Ok(())
    }

    #[test]
    fn only_first_action_is_executed() -> Result<(), Box<dyn std::error::Error>> {
        struct MultiActionController {
            calls: AtomicUsize,
        }

        impl Controller for MultiActionController {
            fn plan(
                &self,
                _context: &ControllerContext,
            ) -> Result<ControllerPlan, Box<dyn std::error::Error>> {
                let call = self.calls.fetch_add(1, Ordering::SeqCst);

                let actions = if call == 0 {
                    vec![
                        ControllerAction::CallTool {
                            tool: "files.list".to_string(),
                            arguments: serde_json::json!({
                                "path": ".",
                                "recursive": false,
                                "limit": 100
                            }),
                        },
                        ControllerAction::CallTool {
                            tool: "files.read".to_string(),
                            arguments: serde_json::json!({
                                "path": "should_not_be_called.txt"
                            }),
                        },
                    ]
                } else {
                    vec![ControllerAction::Respond {
                        text: "Done.".to_string(),
                    }]
                };

                Ok(ControllerPlan {
                    reasoning_summary: "Test sequential action execution.".to_string(),
                    actions,
                })
            }
        }

        struct CountingTools {
            calls: std::sync::Arc<AtomicUsize>,
        }

        impl ToolExecutor for CountingTools {
            fn definition(
                &self,
                tool: &str,
            ) -> Result<tools::ToolDefinition, Box<dyn std::error::Error>> {
                if tool != "files.list" {
                    return Err(format!("Unexpected tool definition: {tool}").into());
                }

                Ok(tools::ToolDefinition {
                    name: tool.to_string(),
                    description: "Test tool".to_string(),
                    permission: tools::ToolPermission::ReadOnly,
                })
            }

            fn execute(&self, call: &ToolCall) -> Result<ToolResult, Box<dyn std::error::Error>> {
                self.calls.fetch_add(1, Ordering::SeqCst);

                match call.tool.as_str() {
                    "files.list" => Ok(ToolResult {
                        success: true,
                        output: serde_json::json!({
                            "entries": []
                        }),
                    }),
                    other => Err(format!("Unexpected tool executed: {other}").into()),
                }
            }
        }

        struct EmptyMemory;

        impl Memory for EmptyMemory {
            fn search(
                &self,
                _query: &str,
                _limit: usize,
            ) -> Result<Vec<MemoryResult>, Box<dyn std::error::Error>> {
                Ok(Vec::new())
            }
        }

        struct EmptyModels;

        impl ModelExecutor for EmptyModels {
            fn execute(
                &self,
                _call: &ModelCall,
            ) -> Result<ModelResult, Box<dyn std::error::Error>> {
                Err("Model executor should not be called.".into())
            }
        }

        let call_count = std::sync::Arc::new(AtomicUsize::new(0));

        let tools = CountingTools {
            calls: std::sync::Arc::clone(&call_count),
        };

        let orchestrator = Orchestrator {
            controller: MultiActionController {
                calls: AtomicUsize::new(0),
            },
            memory: EmptyMemory,
            tools,
            models: EmptyModels,
            approvals: Box::new(DenyAllApproval),
        };

        let result = orchestrator.run(UserRequest {
            text: "test".to_string(),
        })?;

        assert_eq!(result, "Done.");
        assert_eq!(call_count.load(Ordering::SeqCst), 1);

        Ok(())
    }

    use super::*;
    use std::sync::atomic::{AtomicUsize, Ordering};

    struct ToolController {
        calls: AtomicUsize,
    }

    impl Controller for ToolController {
        fn plan(
            &self,
            context: &ControllerContext,
        ) -> Result<ControllerPlan, Box<dyn std::error::Error>> {
            let call_count = self.calls.fetch_add(1, Ordering::SeqCst);

            if call_count == 0 {
                Ok(ControllerPlan {
                    reasoning_summary: "Use the approved tool.".to_string(),
                    actions: vec![ControllerAction::CallTool {
                        tool: "memory.write".to_string(),
                        arguments: serde_json::json!({
                            "path": "test.md",
                            "title": "Approval Test",
                            "type": "journal",
                            "body": "Approval passed."
                        }),
                    }],
                })
            } else {
                assert_eq!(context.observations.len(), 1);

                Ok(ControllerPlan {
                    reasoning_summary: "The tool succeeded.".to_string(),
                    actions: vec![ControllerAction::Respond {
                        text: "Write completed.".to_string(),
                    }],
                })
            }
        }
    }

    struct EmptyMemory;

    impl Memory for EmptyMemory {
        fn search(
            &self,
            _query: &str,
            _limit: usize,
        ) -> Result<Vec<MemoryResult>, Box<dyn std::error::Error>> {
            Ok(Vec::new())
        }
    }

    struct RecordingTools {
        executions: AtomicUsize,
    }

    impl ToolExecutor for RecordingTools {
        fn definition(
            &self,
            tool: &str,
        ) -> Result<tools::ToolDefinition, Box<dyn std::error::Error>> {
            if tool != "memory.write" {
                return Err(format!("Unexpected tool definition: {tool}").into());
            }

            Ok(tools::ToolDefinition {
                name: tool.to_string(),
                description: "Test tool".to_string(),
                permission: tools::ToolPermission::ApprovalRequired,
            })
        }

        fn execute(&self, call: &ToolCall) -> Result<ToolResult, Box<dyn std::error::Error>> {
            assert_eq!(call.tool, "memory.write");

            self.executions.fetch_add(1, Ordering::SeqCst);

            Ok(ToolResult {
                success: true,
                output: serde_json::json!({
                    "created": true
                }),
            })
        }
    }

    struct EmptyModels;

    impl ModelExecutor for EmptyModels {
        fn execute(&self, _call: &ModelCall) -> Result<ModelResult, Box<dyn std::error::Error>> {
            Err("Models disabled in approval tests.".into())
        }
    }

    struct AllowAll;

    impl ApprovalHandler for AllowAll {
        fn approve(&self, _call: &ToolCall) -> Result<bool, Box<dyn std::error::Error>> {
            Ok(true)
        }
    }

    struct DenyAll;

    impl ApprovalHandler for DenyAll {
        fn approve(&self, _call: &ToolCall) -> Result<bool, Box<dyn std::error::Error>> {
            Ok(false)
        }
    }

    #[test]
    fn rust_tool_permission_controls_approval() -> Result<(), Box<dyn std::error::Error>> {
        struct ApprovalAwareController;

        impl Controller for ApprovalAwareController {
            fn plan(
                &self,
                context: &ControllerContext,
            ) -> Result<ControllerPlan, Box<dyn std::error::Error>> {
                if context.observations.is_empty() {
                    Ok(ControllerPlan {
                        reasoning_summary: "Call the tool.".to_string(),
                        actions: vec![ControllerAction::CallTool {
                            tool: "test.write".to_string(),
                            arguments: serde_json::json!({}),
                        }],
                    })
                } else {
                    Ok(ControllerPlan {
                        reasoning_summary: "Respond.".to_string(),
                        actions: vec![ControllerAction::Respond {
                            text: "Approved by Rust policy.".to_string(),
                        }],
                    })
                }
            }
        }

        struct ApprovalAwareTools;

        impl ToolExecutor for ApprovalAwareTools {
            fn definition(
                &self,
                tool: &str,
            ) -> Result<tools::ToolDefinition, Box<dyn std::error::Error>> {
                if tool != "test.write" {
                    return Err(format!("Unexpected tool: {tool}").into());
                }

                Ok(tools::ToolDefinition {
                    name: tool.to_string(),
                    description: "Test write tool".to_string(),
                    permission: tools::ToolPermission::ApprovalRequired,
                })
            }

            fn execute(&self, _call: &ToolCall) -> Result<ToolResult, Box<dyn std::error::Error>> {
                Ok(ToolResult {
                    success: true,
                    output: serde_json::json!({"created": true}),
                })
            }
        }

        struct EmptyMemory;

        impl Memory for EmptyMemory {
            fn search(
                &self,
                _query: &str,
                _limit: usize,
            ) -> Result<Vec<MemoryResult>, Box<dyn std::error::Error>> {
                Ok(Vec::new())
            }
        }

        struct EmptyModels;

        impl ModelExecutor for EmptyModels {
            fn execute(
                &self,
                _call: &ModelCall,
            ) -> Result<ModelResult, Box<dyn std::error::Error>> {
                Err("Models disabled.".into())
            }
        }

        struct CountingApproval {
            calls: std::sync::Arc<AtomicUsize>,
        }

        impl ApprovalHandler for CountingApproval {
            fn approve(&self, _call: &ToolCall) -> Result<bool, Box<dyn std::error::Error>> {
                self.calls.fetch_add(1, Ordering::SeqCst);
                Ok(true)
            }
        }

        let approval_calls = std::sync::Arc::new(AtomicUsize::new(0));

        let approval = CountingApproval {
            calls: std::sync::Arc::clone(&approval_calls),
        };

        let orchestrator = Orchestrator {
            controller: ApprovalAwareController,
            memory: EmptyMemory,
            tools: ApprovalAwareTools,
            models: EmptyModels,
            approvals: Box::new(approval),
        };

        let response = orchestrator.run(UserRequest {
            text: "Use the approval-gated test tool.".to_string(),
        })?;

        assert_eq!(response, "Approved by Rust policy.");
        assert_eq!(approval_calls.load(Ordering::SeqCst), 1);

        Ok(())
    }

    #[test]
    fn approved_tool_is_executed() -> Result<(), Box<dyn std::error::Error>> {
        let tools = RecordingTools {
            executions: AtomicUsize::new(0),
        };

        let orchestrator = Orchestrator {
            controller: ToolController {
                calls: AtomicUsize::new(0),
            },
            memory: EmptyMemory,
            tools,
            models: EmptyModels,
            approvals: Box::new(AllowAll),
        };

        let response = orchestrator.run(UserRequest {
            text: "Write memory.".to_string(),
        })?;

        assert_eq!(response, "Saved to persistent memory.");

        Ok(())
    }

    #[test]
    fn denied_tool_is_never_executed() -> Result<(), Box<dyn std::error::Error>> {
        struct NeverExecute;

        impl ToolExecutor for NeverExecute {
            fn definition(
                &self,
                _tool: &str,
            ) -> Result<tools::ToolDefinition, Box<dyn std::error::Error>> {
                Ok(tools::ToolDefinition {
                    name: "memory.write".to_string(),
                    description: "Test tool".to_string(),
                    permission: tools::ToolPermission::ApprovalRequired,
                })
            }

            fn execute(&self, _call: &ToolCall) -> Result<ToolResult, Box<dyn std::error::Error>> {
                Err("Tool execution should not occur.".into())
            }
        }

        let orchestrator = Orchestrator {
            controller: ToolController {
                calls: AtomicUsize::new(0),
            },
            memory: EmptyMemory,
            tools: NeverExecute,
            models: EmptyModels,
            approvals: Box::new(DenyAll),
        };

        let result = orchestrator.run(UserRequest {
            text: "Write memory.".to_string(),
        });

        assert!(result.is_err());

        Ok(())
    }
}

#[cfg(test)]
mod response_continuation_tests {
    use super::*;

    #[test]
    fn successful_tool_execution_requires_response_schema() {
        let _trace = OrchestrationTrace {
            step: 0,
            action: ControllerAction::CallTool {
                tool: "memory.write".to_string(),
                arguments: serde_json::json!({
                    "path": "test.md"
                }),
            },
            result: ActionResult::Tool {
                result: ToolResult {
                    success: true,
                    output: serde_json::json!({
                        "created": true,
                        "path": "test.md"
                    }),
                },
            },
        };

        let schema = LlamaCppController::response_only_query_plan_schema();

        assert_eq!(
            schema["properties"]["intent"]["properties"]["kind"]["const"],
            "respond"
        );
    }
}

#[cfg(test)]
mod memory_write_terminal_tests {
    use super::*;
    use std::sync::atomic::{AtomicUsize, Ordering};

    struct RepeatingWriter {
        calls: AtomicUsize,
    }

    impl Controller for RepeatingWriter {
        fn plan(
            &self,
            _context: &ControllerContext,
        ) -> Result<ControllerPlan, Box<dyn std::error::Error>> {
            self.calls.fetch_add(1, Ordering::SeqCst);

            Ok(ControllerPlan {
                reasoning_summary: "Write the memory.".to_string(),
                actions: vec![ControllerAction::CallTool {
                    tool: "memory.write".to_string(),
                    arguments: serde_json::json!({
                        "path": "test.md",
                        "title": "Test",
                        "type": "journal",
                        "body": "Saved."
                    }),
                }],
            })
        }
    }

    struct EmptyMemory;

    impl Memory for EmptyMemory {
        fn search(
            &self,
            _query: &str,
            _limit: usize,
        ) -> Result<Vec<MemoryResult>, Box<dyn std::error::Error>> {
            Ok(Vec::new())
        }
    }

    struct RecordingTools {
        executions: AtomicUsize,
    }

    impl ToolExecutor for RecordingTools {
        fn definition(
            &self,
            tool: &str,
        ) -> Result<tools::ToolDefinition, Box<dyn std::error::Error>> {
            if tool != "memory.write" {
                return Err(format!("Unexpected tool definition: {tool}").into());
            }

            Ok(tools::ToolDefinition {
                name: tool.to_string(),
                description: "Test tool".to_string(),
                permission: tools::ToolPermission::ApprovalRequired,
            })
        }

        fn execute(&self, call: &ToolCall) -> Result<ToolResult, Box<dyn std::error::Error>> {
            assert_eq!(call.tool, "memory.write");

            self.executions.fetch_add(1, Ordering::SeqCst);

            Ok(ToolResult {
                success: true,
                output: serde_json::json!({
                    "created": true
                }),
            })
        }
    }

    struct EmptyModels;

    impl ModelExecutor for EmptyModels {
        fn execute(&self, _call: &ModelCall) -> Result<ModelResult, Box<dyn std::error::Error>> {
            Err("Models disabled.".into())
        }
    }

    struct AllowAll;

    impl ApprovalHandler for AllowAll {
        fn approve(&self, _call: &ToolCall) -> Result<bool, Box<dyn std::error::Error>> {
            Ok(true)
        }
    }

    #[test]
    fn successful_memory_write_terminates_run() -> Result<(), Box<dyn std::error::Error>> {
        let tools = RecordingTools {
            executions: AtomicUsize::new(0),
        };

        let controller = RepeatingWriter {
            calls: AtomicUsize::new(0),
        };

        let orchestrator = Orchestrator {
            controller,
            memory: EmptyMemory,
            tools,
            models: EmptyModels,
            approvals: Box::new(AllowAll),
        };

        let response = orchestrator.run(UserRequest {
            text: "Remember this.".to_string(),
        })?;

        assert_eq!(response, "Saved to persistent memory.");

        assert_eq!(orchestrator.controller.calls.load(Ordering::SeqCst), 1);

        assert_eq!(orchestrator.tools.executions.load(Ordering::SeqCst), 1);

        Ok(())
    }
}

#[derive(Clone)]
pub struct PersistentMemoryIndexer {
    db: std::sync::Arc<std::sync::Mutex<sqlite_memory::SqliteMemoryDb>>,
    memory_root: std::path::PathBuf,
    embedder: embedding::LlamaCppEmbedder,
}

#[derive(Debug, Clone, Deserialize)]
#[serde(deny_unknown_fields)]
struct ProposalItem {
    kind: String,
    title: String,
    body: String,
    #[serde(default)]
    tags: Vec<String>,
    #[serde(default)]
    entities: Vec<tools::MemoryWriteEntity>,
    #[serde(default)]
    relationships: Vec<tools::MemoryWriteRelationship>,
    #[serde(default)]
    events: Vec<tools::MemoryWriteEvent>,
    #[serde(default)]
    states: Vec<tools::MemoryWriteState>,
    #[serde(default)]
    task_status: Option<String>,
    #[serde(default)]
    reminder_status: Option<String>,
    #[serde(default)]
    due_at: Option<String>,
}

#[derive(Debug, Clone, Deserialize)]
#[serde(deny_unknown_fields)]
struct ProposalPayload {
    decision: String,
    #[serde(default)]
    items: Vec<ProposalItem>,
}

impl PersistentMemoryIndexer {
    /// Returns whether any background job is currently running without requiring
    /// access to the orchestrator mutex. Runtime lifecycle checks call this from
    /// the IPC accept loop, so it must never depend on the orchestrator lock.
    pub fn has_running_jobs(&self) -> Result<bool, Box<dyn std::error::Error>> {
        let db = self
            .db
            .lock()
            .map_err(|_| "Persistent memory indexer database mutex was poisoned.")?;
        Ok(!db.jobs(Some("running"), 1000)?.is_empty())
    }

    pub fn new(
        db_path: impl AsRef<std::path::Path>,
        memory_root: impl AsRef<std::path::Path>,
        embedding_url: impl Into<String>,
        embedding_model: impl Into<String>,
    ) -> Result<Self, Box<dyn std::error::Error>> {
        let db = sqlite_memory::SqliteMemoryDb::open(db_path)?;

        db.initialize_schema()?;
        db.initialize_vector_index(384)?;

        Ok(Self {
            db: std::sync::Arc::new(std::sync::Mutex::new(db)),
            memory_root: memory_root.as_ref().to_path_buf(),
            embedder: embedding::LlamaCppEmbedder::new(embedding_url, embedding_model),
        })
    }

    pub fn pending_memory_extraction_proposals(
        &self,
        limit: usize,
    ) -> Result<Vec<sqlite_memory::MemoryExtractionProposal>, Box<dyn std::error::Error>> {
        let db = self
            .db
            .lock()
            .map_err(|_| "Persistent memory indexer database mutex was poisoned.")?;
        Ok(db.pending_memory_extraction_proposals(limit)?)
    }

    pub fn reject_memory_extraction_proposal(
        &self,
        proposal_id: &str,
    ) -> Result<bool, Box<dyn std::error::Error>> {
        let db = self
            .db
            .lock()
            .map_err(|_| "Persistent memory indexer database mutex was poisoned.")?;
        Ok(db.reject_memory_extraction_proposal(proposal_id)?)
    }

    pub fn apply_memory_extraction_proposal(
        &self,
        proposal_id: &str,
    ) -> Result<Vec<String>, Box<dyn std::error::Error>> {
        let proposal = {
            let db = self
                .db
                .lock()
                .map_err(|_| "Persistent memory indexer database mutex was poisoned.")?;
            db.memory_extraction_proposal(proposal_id)?
                .ok_or("Memory extraction proposal was not found.")?
        };

        if proposal.status == "applied" {
            return Ok(Vec::new());
        }
        if proposal.status == "rejected" {
            return Err("Rejected memory extraction proposals cannot be applied.".into());
        }
        if !matches!(proposal.status.as_str(), "pending" | "applying") {
            return Err("Memory extraction proposal has an unsupported status.".into());
        }
        if !matches!(proposal.decision.as_str(), "must_save" | "should_save") {
            return Err(
                "Only must_save or should_save memory extraction proposals can be applied.".into(),
            );
        }

        // Refresh before evolution analysis so external Markdown edits made since
        // startup are reflected in the derived memory index.
        self.refresh()?;

        let payload: ProposalPayload = serde_json::from_str(&proposal.payload_json)?;
        if payload.decision != proposal.decision {
            return Err("Memory extraction proposal decision does not match its payload.".into());
        }
        if payload.items.is_empty() || payload.items.len() > 4 {
            return Err("Memory extraction proposal must contain 1..=4 items.".into());
        }

        let turn = {
            let db = self
                .db
                .lock()
                .map_err(|_| "Persistent memory indexer database mutex was poisoned.")?;
            db.conversation_turn(proposal.conversation_turn_id)?
                .ok_or("Memory extraction proposal references a missing conversation turn.")?
        };

        if proposal.status == "pending" {
            let db = self
                .db
                .lock()
                .map_err(|_| "Persistent memory indexer database mutex was poisoned.")?;
            if !db.set_memory_extraction_proposal_status(&proposal.id, "pending", "applying")? {
                let latest = db
                    .memory_extraction_proposal(&proposal.id)?
                    .ok_or("Memory extraction proposal disappeared before application.")?;
                if latest.status == "rejected" {
                    return Err(
                        "Memory extraction proposal was rejected before application.".into(),
                    );
                }
                if latest.status != "applying" {
                    return Err("Memory extraction proposal changed before application.".into());
                }
            }
        }

        let writer = tools::MemoryWriteTool::new(&self.memory_root);
        let mut paths = Vec::with_capacity(payload.items.len());
        let mut wrote_memory = false;
        let mut modified_existing_memory = false;
        let mut evolution_blockers = Vec::new();

        for (index, item) in payload.items.iter().enumerate() {
            if item.kind.trim().is_empty()
                || item.kind.chars().count() > 64
                || item.kind.contains(['\n', '\r'])
            {
                return Err("Memory extraction item kind is invalid.".into());
            }

            let graph_states = item
                .states
                .iter()
                .map(|state| sqlite_memory::GraphState {
                    entity: state.entity.clone(),
                    state: state.state.clone(),
                    valid_from: state.valid_from.clone(),
                    valid_to: state.valid_to.clone(),
                })
                .collect::<Vec<_>>();

            let assessment = {
                let db = self
                    .db
                    .lock()
                    .map_err(|_| "Persistent memory indexer database mutex was poisoned.")?;
                db.assess_memory_evolution(&item.title, &item.body, &graph_states)?
            };

            match assessment.disposition {
                sqlite_memory::MemoryEvolutionDisposition::New
                | sqlite_memory::MemoryEvolutionDisposition::Duplicate
                | sqlite_memory::MemoryEvolutionDisposition::SupersessionRequired => {}
                sqlite_memory::MemoryEvolutionDisposition::Ambiguous => {
                    let details = assessment
                        .matches
                        .iter()
                        .take(3)
                        .map(|match_info| match_info.path.clone())
                        .collect::<Vec<_>>()
                        .join(", ");
                    evolution_blockers.push(format!(
                        "item {} has multiple eligible predecessors and requires clarification: {}",
                        index + 1,
                        details
                    ));
                }
                sqlite_memory::MemoryEvolutionDisposition::Conflict => {
                    let details = assessment
                        .matches
                        .iter()
                        .take(3)
                        .map(|match_info| match_info.path.clone())
                        .collect::<Vec<_>>()
                        .join(", ");
                    evolution_blockers.push(format!(
                        "item {} requires conflict resolution because existing memory matches: {}",
                        index + 1,
                        details
                    ));
                }
            }
        }

        if !evolution_blockers.is_empty() {
            let db = self
                .db
                .lock()
                .map_err(|_| "Persistent memory indexer database mutex was poisoned.")?;
            let _ =
                db.set_memory_extraction_proposal_status(&proposal.id, "applying", "pending")?;
            return Err(format!(
                "Memory proposal requires evolution resolution before it can be applied: {}",
                evolution_blockers.join("; ")
            )
            .into());
        }

        for (index, item) in payload.items.iter().enumerate() {
            let graph_states = item
                .states
                .iter()
                .map(|state| sqlite_memory::GraphState {
                    entity: state.entity.clone(),
                    state: state.state.clone(),
                    valid_from: state.valid_from.clone(),
                    valid_to: state.valid_to.clone(),
                })
                .collect::<Vec<_>>();

            let assessment = {
                let db = self
                    .db
                    .lock()
                    .map_err(|_| "Persistent memory indexer database mutex was poisoned.")?;
                db.assess_memory_evolution(&item.title, &item.body, &graph_states)?
            };

            if assessment.disposition == sqlite_memory::MemoryEvolutionDisposition::Duplicate {
                if let Some(match_info) = assessment.matches.first() {
                    paths.push(match_info.path.clone());
                }
                continue;
            }

            let path = format!("journal/extracted/{}-{}.md", proposal.id, index + 1);
            let request = tools::MemoryWriteRequest {
                path: path.clone(),
                title: item.title.clone(),
                note_type: "journal".to_string(),
                body: item.body.clone(),
                tags: item.tags.clone(),
                entities: item.entities.clone(),
                relationships: item.relationships.clone(),
                events: item.events.clone(),
                states: item.states.clone(),
                memory_kind: Some(item.kind.clone()),
                task_status: item.task_status.clone(),
                reminder_status: item.reminder_status.clone(),
                due_at: item.due_at.clone(),
                source_type: Some("conversation".to_string()),
                source_id: Some(format!("conversation_turn:{}", turn.id)),
                source_path: Some(format!("session:{}", turn.session_id)),
                source_anchor: Some(format!("turn:{}", turn.id)),
                source_excerpt: Some(turn.user_text.chars().take(1000).collect()),
            };

            let write_result = writer.write_request_idempotent(&request)?;
            wrote_memory |= write_result.output["created"].as_bool().unwrap_or(false);

            if assessment.disposition
                == sqlite_memory::MemoryEvolutionDisposition::SupersessionRequired
            {
                for state in &item.states {
                    let state_assessment = {
                        let db = self.db.lock().map_err(
                            |_| "Persistent memory indexer database mutex was poisoned.",
                        )?;
                        db.assess_memory_evolution(
                            &item.title,
                            &item.body,
                            &[sqlite_memory::GraphState {
                                entity: state.entity.clone(),
                                state: state.state.clone(),
                                valid_from: state.valid_from.clone(),
                                valid_to: state.valid_to.clone(),
                            }],
                        )?
                    };

                    if state_assessment.disposition
                        != sqlite_memory::MemoryEvolutionDisposition::SupersessionRequired
                    {
                        continue;
                    }

                    let successor_start = state
                        .valid_from
                        .as_deref()
                        .ok_or("Supersession requires a valid_from date.")?;
                    let predecessor_valid_to =
                        sqlite_memory::SqliteMemoryDb::supersession_valid_to(successor_start)?;

                    for match_info in state_assessment.matches {
                        let predecessor_state = match_info
                            .existing_state
                            .as_deref()
                            .ok_or("Supersession match is missing its predecessor state.")?;
                        writer.supersede_state_in_file(
                            &match_info.path,
                            &state.entity,
                            predecessor_state,
                            &predecessor_valid_to,
                        )?;
                        modified_existing_memory = true;
                    }
                }
            }

            paths.push(path);
        }

        if wrote_memory || modified_existing_memory {
            self.refresh()?;
        }

        let db = self
            .db
            .lock()
            .map_err(|_| "Persistent memory indexer database mutex was poisoned.")?;
        if !db.set_memory_extraction_proposal_status(&proposal.id, "applying", "applied")? {
            let latest = db
                .memory_extraction_proposal(&proposal.id)?
                .ok_or("Memory extraction proposal disappeared during application.")?;
            if latest.status != "applied" {
                return Err("Memory extraction proposal was changed during application.".into());
            }
        }

        Ok(paths)
    }

    pub fn refresh_index_without_embeddings(&self) -> Result<(), Box<dyn std::error::Error>> {
        let snapshot = indexer::build_snapshot_from(&self.memory_root)?;

        let mut db = self
            .db
            .lock()
            .map_err(|_| "Persistent memory indexer database mutex was poisoned.")?;

        db.sync_snapshot(&snapshot)?;
        db.sync_semantics(&snapshot)?;

        Ok(())
    }

    pub fn refresh(&self) -> Result<(), Box<dyn std::error::Error>> {
        let snapshot = indexer::build_snapshot_from(&self.memory_root)?;

        let mut db = self
            .db
            .lock()
            .map_err(|_| "Persistent memory indexer database mutex was poisoned.")?;

        db.sync_snapshot(&snapshot)?;

        db.sync_semantics(&snapshot)?;

        for chunk in &snapshot.chunks {
            if db.has_chunk_embedding(&chunk.id)? {
                continue;
            }

            let embedding = self.embedder.embed(&chunk.text)?;

            db.upsert_chunk_embedding(&chunk.id, &embedding)?;
        }

        Ok(())
    }
}

#[cfg(test)]
mod persistent_memory_proposal_tests {
    use super::*;
    use std::{
        io::{Read, Write},
        net::TcpListener,
        thread,
    };

    fn start_embedding_server()
    -> Result<(String, thread::JoinHandle<()>), Box<dyn std::error::Error>> {
        start_embedding_server_with_requests(1)
    }

    fn start_embedding_server_with_requests(
        request_count: usize,
    ) -> Result<(String, thread::JoinHandle<()>), Box<dyn std::error::Error>> {
        let listener = TcpListener::bind("127.0.0.1:0")?;
        let address = listener.local_addr()?;
        let handle = thread::spawn(move || {
            for _ in 0..request_count {
                let (mut stream, _) = listener
                    .accept()
                    .expect("embedding mock server accept failed");
                let mut request = [0u8; 8192];
                let _ = stream
                    .read(&mut request)
                    .expect("embedding mock server read failed");

                let embedding = vec![0.0f32; 384];
                let body = serde_json::json!({
                    "data": [{"embedding": embedding}]
                })
                .to_string();
                let response = format!(
                    "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}",
                    body.len(),
                    body
                );
                stream
                    .write_all(response.as_bytes())
                    .expect("embedding mock server write failed");
            }
        });
        Ok((format!("http://{}", address), handle))
    }

    #[test]
    fn persistent_memory_indexer_reports_running_jobs_without_orchestrator_lock()
    -> Result<(), Box<dyn std::error::Error>> {
        let root = tempfile::tempdir()?;
        let memory_root = root.path().join("memory");
        std::fs::create_dir_all(&memory_root)?;
        let database = root.path().join("assistant.db");

        let indexer = PersistentMemoryIndexer::new(
            &database,
            &memory_root,
            "http://127.0.0.1:1",
            "test-embedding-model",
        )?;

        assert!(!indexer.has_running_jobs()?);

        let db = sqlite_memory::SqliteMemoryDb::open(&database)?;
        db.initialize_schema()?;
        let id = db.enqueue_job(
            "test-running-job",
            None,
            None,
            0,
            Some("2099-01-01T00:00:00Z"),
        )?;
        assert!(db.claim_next_job("2099-01-01T00:00:00Z")?.is_some());
        assert_eq!(
            db.job(&id)?.expect("job missing").status,
            sqlite_memory::JobStatus::Running
        );

        assert!(indexer.has_running_jobs()?);
        Ok(())
    }

    #[test]
    fn metadata_refresh_reconciles_reminder_due_without_embeddings()
    -> Result<(), Box<dyn std::error::Error>> {
        let root = tempfile::tempdir()?;
        let memory_root = root.path().join("memory");
        let reminder_root = memory_root.join("journal/reminders");
        std::fs::create_dir_all(&reminder_root)?;
        let database = root.path().join("assistant.db");

        std::fs::write(
            reminder_root.join("reminder-test.md"),
            r#"---
id: "reminder-test"
title: "Calendar test"
type: "journal"
memory_kind: "reminder"
reminder_status: "scheduled"
due_at: "2026-09-22T19:50:00Z"
created_at: "2026-09-22T18:00:00Z"
updated_at: "2026-09-22T18:00:00Z"
calendar_sync_enabled: "true"
calendar_sync_status: "synced"
google_event_id: "event-123"
---

Verify calendar sync.
"#,
        )?;

        let indexer = PersistentMemoryIndexer::new(
            &database,
            &memory_root,
            "http://127.0.0.1:9",
            "unused.gguf",
        )?;
        indexer.refresh_index_without_embeddings()?;

        let db = sqlite_memory::SqliteMemoryDb::open(&database)?;
        let reminder = db
            .reminder("reminder:reminder-test")?
            .ok_or("Reminder was not indexed.")?;

        assert_eq!(reminder.due_at.as_deref(), Some("2026-09-22T19:50:00Z"));
        assert_eq!(reminder.status, "scheduled");
        Ok(())
    }

    #[test]
    fn applying_memory_proposal_writes_provenance_and_refreshes_index()
    -> Result<(), Box<dyn std::error::Error>> {
        let root = tempfile::tempdir()?;
        let memory_root = root.path().join("memory");
        std::fs::create_dir_all(&memory_root)?;
        let database = root.path().join("assistant.db");

        let writer_db = sqlite_memory::SqliteMemoryDb::open(&database)?;
        writer_db.initialize_schema()?;
        let turn_id = writer_db.append_conversation_turn(
            "session-1",
            "Remember that Qwen is my local model.",
            "Understood.",
        )?;
        let proposal_id = writer_db.store_memory_extraction_proposal(
            turn_id,
            "must_save",
            r#"{
                "decision":"must_save",
                "items":[{
                    "kind":"preference",
                    "title":"Local model preference",
                    "body":"Qwen is my local model.",
                    "tags":["local-ai"],
                    "entities":[{"name":"Qwen","type":"technology"}],
                    "relationships":[],
                    "events":[],
                    "states":[]
                }]
            }"#,
        )?;
        drop(writer_db);

        let (embedding_url, handle) = start_embedding_server()?;
        let indexer = PersistentMemoryIndexer::new(
            &database,
            &memory_root,
            embedding_url,
            "test-embedding-model",
        )?;

        let paths = indexer.apply_memory_extraction_proposal(&proposal_id)?;
        assert_eq!(paths.len(), 1);
        let file = memory_root.join(&paths[0]);
        let contents = std::fs::read_to_string(file)?;
        assert!(contents.contains("memory_kind: \"preference\""));
        assert!(contents.contains("source_type: \"conversation\""));
        assert!(contents.contains("source_id: \"conversation_turn:"));

        let db = sqlite_memory::SqliteMemoryDb::open(&database)?;
        db.initialize_schema()?;
        let proposal = db
            .memory_extraction_proposal(&proposal_id)?
            .ok_or("proposal missing")?;
        assert_eq!(proposal.status, "applied");
        assert_eq!(db.semantic_counts()?.entities, 1);

        assert!(
            indexer
                .apply_memory_extraction_proposal(&proposal_id)?
                .is_empty()
        );
        handle
            .join()
            .map_err(|_| "embedding mock server thread panicked")?;
        Ok(())
    }

    #[test]
    fn applying_duplicate_memory_proposal_is_idempotent() -> Result<(), Box<dyn std::error::Error>>
    {
        let root = tempfile::tempdir()?;
        let memory_root = root.path().join("memory");
        std::fs::create_dir_all(&memory_root)?;
        let database = root.path().join("assistant.db");

        let writer = tools::MemoryWriteTool::new(&memory_root);
        writer.write_request_idempotent(&tools::MemoryWriteRequest {
            path: "journal/extracted/existing.md".to_string(),
            title: "Local model".to_string(),
            note_type: "journal".to_string(),
            body: "Qwen is the local model.".to_string(),
            tags: Vec::new(),
            entities: Vec::new(),
            relationships: Vec::new(),
            events: Vec::new(),
            states: Vec::new(),
            memory_kind: Some("fact".to_string()),
            task_status: None,
            reminder_status: None,
            due_at: None,
            source_type: None,
            source_id: None,
            source_path: None,
            source_anchor: None,
            source_excerpt: None,
        })?;

        let proposal_db = sqlite_memory::SqliteMemoryDb::open(&database)?;
        proposal_db.initialize_schema()?;
        let turn_id = proposal_db.append_conversation_turn(
            "session-duplicate",
            "Remember that Qwen is the local model.",
            "Done.",
        )?;
        let proposal_id = proposal_db.store_memory_extraction_proposal(
            turn_id,
            "must_save",
            r#"{"decision":"must_save","items":[{"kind":"fact","title":"Local model","body":"Qwen is the local model.","tags":[],"entities":[],"relationships":[],"events":[],"states":[]}] }"#,
        )?;
        drop(proposal_db);

        let (embedding_url, handle) = start_embedding_server()?;
        let indexer = PersistentMemoryIndexer::new(
            &database,
            &memory_root,
            embedding_url,
            "test-embedding-model",
        )?;

        let paths = indexer.apply_memory_extraction_proposal(&proposal_id)?;

        assert_eq!(paths, vec!["journal/extracted/existing.md".to_string()]);
        let proposal = indexer
            .db
            .lock()
            .map_err(|_| "Persistent memory indexer database mutex was poisoned.")?
            .memory_extraction_proposal(&proposal_id)?
            .ok_or("proposal missing")?;
        assert_eq!(proposal.status, "applied");

        assert!(
            !memory_root
                .join("journal/extracted/")
                .join(format!("{}-1.md", proposal_id))
                .exists()
        );

        handle
            .join()
            .map_err(|_| "embedding mock server thread panicked")?;
        Ok(())
    }

    #[test]
    fn applying_ambiguous_memory_proposal_leaves_it_pending()
    -> Result<(), Box<dyn std::error::Error>> {
        let root = tempfile::tempdir()?;
        let memory_root = root.path().join("memory");
        std::fs::create_dir_all(&memory_root)?;
        let database = root.path().join("assistant.db");

        let writer = tools::MemoryWriteTool::new(&memory_root);
        for (path, state, valid_from) in [
            ("journal/extracted/state-a.md", "active", "2026-01-01"),
            ("journal/extracted/state-b.md", "planning", "2026-06-01"),
        ] {
            writer.write_request_idempotent(&tools::MemoryWriteRequest {
                path: path.to_string(),
                title: "Project state".to_string(),
                note_type: "journal".to_string(),
                body: format!("Project is {state}."),
                tags: vec![],
                entities: vec![tools::MemoryWriteEntity {
                    name: "Project".to_string(),
                    entity_type: "project".to_string(),
                }],
                relationships: vec![],
                events: vec![],
                states: vec![tools::MemoryWriteState {
                    entity: "Project".to_string(),
                    state: state.to_string(),
                    valid_from: Some(valid_from.to_string()),
                    valid_to: None,
                }],
                memory_kind: Some("state".to_string()),
                task_status: None,
                reminder_status: None,
                due_at: None,
                source_type: None,
                source_id: None,
                source_path: None,
                source_anchor: None,
                source_excerpt: None,
            })?;
        }

        let proposal_db = sqlite_memory::SqliteMemoryDb::open(&database)?;
        proposal_db.initialize_schema()?;
        let turn_id = proposal_db.append_conversation_turn(
            "session-ambiguous",
            "The project is paused now.",
            "Understood.",
        )?;
        let proposal_id = proposal_db.store_memory_extraction_proposal(
            turn_id,
            "must_save",
            r#"{"decision":"must_save","items":[{"kind":"state","title":"Project paused","body":"Project is paused.","tags":[],"entities":[{"name":"Project","type":"project"}],"relationships":[],"events":[],"states":[{"entity":"Project","state":"paused","valid_from":"2026-09-12","valid_to":null}]}]}"#,
        )?;
        drop(proposal_db);

        let (embedding_url, handle) = start_embedding_server_with_requests(2)?;
        let indexer = PersistentMemoryIndexer::new(
            &database,
            &memory_root,
            embedding_url,
            "test-embedding-model",
        )?;

        let result = indexer.apply_memory_extraction_proposal(&proposal_id);
        assert!(result.is_err());
        let proposal = indexer
            .db
            .lock()
            .map_err(|_| "Persistent memory indexer database mutex was poisoned.")?
            .memory_extraction_proposal(&proposal_id)?
            .ok_or("proposal missing")?;
        assert_eq!(proposal.status, "pending");
        assert!(
            !memory_root
                .join("journal/extracted/")
                .join(format!("{}-1.md", proposal_id))
                .exists()
        );

        handle
            .join()
            .map_err(|_| "embedding mock server thread panicked")?;
        Ok(())
    }

    #[test]
    fn applying_superseding_memory_proposal_closes_previous_state()
    -> Result<(), Box<dyn std::error::Error>> {
        let root = tempfile::tempdir()?;
        let memory_root = root.path().join("memory");
        std::fs::create_dir_all(&memory_root)?;
        let database = root.path().join("assistant.db");

        let writer = tools::MemoryWriteTool::new(&memory_root);
        writer.write_request_idempotent(&tools::MemoryWriteRequest {
            path: "journal/extracted/old-state.md".to_string(),
            title: "Project state".to_string(),
            note_type: "journal".to_string(),
            body: "Project is active.".to_string(),
            tags: vec![],
            entities: vec![tools::MemoryWriteEntity {
                name: "Project".to_string(),
                entity_type: "project".to_string(),
            }],
            relationships: vec![],
            events: vec![],
            states: vec![tools::MemoryWriteState {
                entity: "Project".to_string(),
                state: "active".to_string(),
                valid_from: Some("2026-01-01".to_string()),
                valid_to: None,
            }],
            memory_kind: Some("state".to_string()),
            task_status: None,
            reminder_status: None,
            due_at: None,
            source_type: None,
            source_id: None,
            source_path: None,
            source_anchor: None,
            source_excerpt: None,
        })?;

        let proposal_db = sqlite_memory::SqliteMemoryDb::open(&database)?;
        proposal_db.initialize_schema()?;
        let turn_id = proposal_db.append_conversation_turn(
            "session-supersede",
            "The project is paused now.",
            "Understood.",
        )?;
        let proposal_id = proposal_db.store_memory_extraction_proposal(
            turn_id,
            "must_save",
            r#"{"decision":"must_save","items":[{"kind":"state","title":"Project paused","body":"Project is paused.","tags":[],"entities":[{"name":"Project","type":"project"}],"relationships":[],"events":[],"states":[{"entity":"Project","state":"paused","valid_from":"2026-09-12","valid_to":null}]}]}"#,
        )?;
        drop(proposal_db);

        let (embedding_url, handle) = start_embedding_server_with_requests(3)?;
        let indexer = PersistentMemoryIndexer::new(
            &database,
            &memory_root,
            embedding_url,
            "test-embedding-model",
        )?;

        let paths = indexer.apply_memory_extraction_proposal(&proposal_id)?;
        assert_eq!(paths.len(), 1);

        let old = std::fs::read_to_string(memory_root.join("journal/extracted/old-state.md"))?;
        assert!(old.contains("valid_to: \"2026-09-11\""));

        let new = std::fs::read_to_string(&memory_root.join(&paths[0]))?;
        assert!(new.contains("valid_from: \"2026-09-12\""));

        let db = sqlite_memory::SqliteMemoryDb::open(&database)?;
        db.initialize_schema()?;
        let before = db.temporal_analysis_for_entity("Project", Some("2026-09-11"))?;
        assert_eq!(before.active_state.unwrap().state, "active");
        let after = db.temporal_analysis_for_entity("Project", Some("2026-09-12"))?;
        assert_eq!(after.active_state.unwrap().state, "paused");
        assert!(!after.ambiguous);

        handle
            .join()
            .map_err(|_| "embedding mock server thread panicked")?;
        Ok(())
    }

    #[test]
    fn applying_conflicting_memory_proposal_leaves_it_pending()
    -> Result<(), Box<dyn std::error::Error>> {
        let root = tempfile::tempdir()?;
        let memory_root = root.path().join("memory");
        std::fs::create_dir_all(&memory_root)?;
        let database = root.path().join("assistant.db");

        let writer = tools::MemoryWriteTool::new(&memory_root);
        writer.write_request_idempotent(&tools::MemoryWriteRequest {
            path: "journal/extracted/state.md".to_string(),
            title: "Project state".to_string(),
            note_type: "journal".to_string(),
            body: "Project is active.".to_string(),
            tags: Vec::new(),
            entities: vec![tools::MemoryWriteEntity {
                name: "Project".to_string(),
                entity_type: "project".to_string(),
            }],
            relationships: Vec::new(),
            events: Vec::new(),
            states: vec![tools::MemoryWriteState {
                entity: "Project".to_string(),
                state: "active".to_string(),
                valid_from: Some("2026-09-01".to_string()),
                valid_to: Some("2026-09-30".to_string()),
            }],
            memory_kind: Some("state".to_string()),
            task_status: None,
            reminder_status: None,
            due_at: None,
            source_type: None,
            source_id: None,
            source_path: None,
            source_anchor: None,
            source_excerpt: None,
        })?;

        let proposal_db = sqlite_memory::SqliteMemoryDb::open(&database)?;
        proposal_db.initialize_schema()?;
        let turn_id = proposal_db.append_conversation_turn(
            "session-conflict",
            "The project is paused from September 15 to September 20.",
            "Understood.",
        )?;
        let proposal_id = proposal_db.store_memory_extraction_proposal(
            turn_id,
            "must_save",
            r#"{"decision":"must_save","items":[{"kind":"state","title":"Project paused","body":"Project is paused.","tags":[],"entities":[{"name":"Project","type":"project"}],"relationships":[],"events":[],"states":[{"entity":"Project","state":"paused","valid_from":"2026-09-15","valid_to":"2026-09-20"}]}] }"#,
        )?;
        drop(proposal_db);

        let (embedding_url, handle) = start_embedding_server()?;
        let indexer = PersistentMemoryIndexer::new(
            &database,
            &memory_root,
            embedding_url,
            "test-embedding-model",
        )?;

        let error = indexer
            .apply_memory_extraction_proposal(&proposal_id)
            .expect_err("conflicting proposal should be blocked");
        assert!(error.to_string().contains("conflict"));

        let db = indexer
            .db
            .lock()
            .map_err(|_| "Persistent memory indexer database mutex was poisoned.")?;
        let proposal = db
            .memory_extraction_proposal(&proposal_id)?
            .ok_or("proposal missing")?;
        assert_eq!(proposal.status, "pending");
        drop(db);

        assert!(
            !memory_root
                .join("journal/extracted/")
                .join(format!("{}-1.md", proposal_id))
                .exists()
        );

        handle
            .join()
            .map_err(|_| "embedding mock server thread panicked")?;
        Ok(())
    }
}

pub struct IndexedToolExecutor {
    registry: tools::ToolRegistry,
    memory_indexer: PersistentMemoryIndexer,
}

impl IndexedToolExecutor {
    pub fn new(registry: tools::ToolRegistry, memory_indexer: PersistentMemoryIndexer) -> Self {
        Self {
            registry,
            memory_indexer,
        }
    }
}

impl ToolExecutor for IndexedToolExecutor {
    fn definition(&self, tool: &str) -> Result<tools::ToolDefinition, Box<dyn std::error::Error>> {
        Ok(self.registry.definition(tool)?)
    }

    fn execute(&self, call: &ToolCall) -> Result<ToolResult, Box<dyn std::error::Error>> {
        let managed_task_tool = matches!(
            call.tool.as_str(),
            "tasks.list" | "tasks.mutate" | "reminders.list" | "reminders.mutate"
        );

        if managed_task_tool {
            self.memory_indexer.refresh()?;
        }

        let result = self.registry.execute(&tools::ToolCall {
            tool: call.tool.clone(),
            arguments: call.arguments.clone(),
        })?;

        if result.success
            && (call.tool == "memory.write"
                || matches!(call.tool.as_str(), "tasks.mutate" | "reminders.mutate"))
        {
            self.memory_indexer.refresh()?;
        }

        Ok(ToolResult {
            success: result.success,
            output: result.output,
        })
    }
}
