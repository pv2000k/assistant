    #[test]
    fn calendar_sync_followup_updates_the_unique_matching_reminder()
    -> Result<(), Box<dyn std::error::Error>> {
        let context = ControllerContext {
            request: UserRequest {
                text: "Sync it to Google Calendar too.".to_string(),
            },
            history: r#"USER:
Remind me to test Chat approval at 15:00.

ASSISTANT:
Reminder created: 'test Chat approval' scheduled for today at 15:00."#
                .to_string(),
            observations: vec![OrchestrationTrace {
                step: 0,
                action: ControllerAction::CallTool {
                    tool: "reminders.list".to_string(),
                    arguments: serde_json::json!({
                        "query": "test Chat approval",
                        "limit": 20
                    }),
                },
                result: ActionResult::Tool {
                    result: ToolResult {
                        success: true,
                        output: serde_json::json!({
                            "items": [
                                {"id": "reminder:test-1", "title": "test Chat approval"}
                            ]
                        }),
                    },
                },
            }],
        };

        let plan = LlamaCppController::deterministic_task_reminder_plan(&context)
            .ok_or("calendar-sync followup did not produce a mutation plan")?;

        assert_eq!(
            plan.intent,
            QueryIntent::CallTool {
                tool: "reminders.mutate".to_string(),
                arguments: serde_json::json!({
                    "operation": "update",
                    "id": "reminder:test-1",
                    "calendar_sync": true
                }),
            }
        );

        Ok(())
    }

