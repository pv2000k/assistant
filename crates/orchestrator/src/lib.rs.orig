    #[test]
    fn conversational_reminder_creation_accepts_relative_due_phrase() {
        for (request, expected_due) in [
            (
                "Remind me in half an hour to test Chat approval.",
                "in half an hour",
            ),
            (
                "Remind me in 5 minutes to test Chat approval.",
                "in 5 minutes",
            ),
        ] {
            let parsed = LlamaCppController::parse_task_reminder_create(request);

            assert_eq!(
                parsed,
                Some((
                    "reminders.mutate",
                    "test Chat approval".to_string(),
                    Some(expected_due.to_string()),
                ))
            );
        }
    }

